timestamp=2026-11-14T07:08:45.893Z level=INFO run=895237dc message=evaluated permission=bash pattern="python3 -c '\nimport math, itertools\n\nr, p, y = -0.087613, 0.11894, 0.06308\ndef qmul(a, b):\n    return [\n        a[0]*b[0] - a[1]*b[1] - a[2]*b[2] - a[3]*b[3],\n        a[0]*b[1] + a[1]*b[0] + a[2]*b[3] - a[3]*b[2],\n        a[0]*b[2] - a[1]*b[3] + a[2]*b[0] + a[3]*b[1],\n        a[0]*b[3] + a[1]*b[2] - a[2]*b[1] + a[3]*b[0],\n    ]\nqx = [math.cos(r/2), math.sin(r/2), 0, 0]\nqy = [math.cos(p/2), 0, math.sin(p/2), 0]\nqz = [math.cos(y/2), 0, 0, math.sin(y/2)]\nqs = {\"X\": qx, \"Y\": qy, \"Z\": qz}\nfor p1, p2, p3 in itertools.permutations([\"X\", \"Y\", \"Z\"]):\n    q = qmul(qmul(qs[p1], qs[p2]), qs[p3])\n    print(f\"{p1}*{p2}*{p3}: [{q[0]:.5f}, {q[1]:.5f}, {q[2]:.5f}, {q[3]:.5f}]\")\nprint(\"ACTUAL: [0.99670, -0.04557, 0.05797, 0.03405]\")\n'" action.permission=* action.action=allow action.pattern=*
