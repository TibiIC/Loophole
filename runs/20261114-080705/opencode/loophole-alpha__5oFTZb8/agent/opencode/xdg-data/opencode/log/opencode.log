timestamp=2026-11-14T06:50:05.471Z level=INFO run=895237dc message=evaluated permission=bash pattern="python3 -c '\nimport struct, math\n\ndef load_pts(fn):\n    d = open(fn, \"rb\").read()\n    n = struct.unpack(\"<I\", d[:4])[0]\n    return [struct.unpack(\"<fff\", d[4+12*i:16+12*i]) for i in range(n)]\n\nsurfA = load_pts(\"/tmp/opencode/surfA_t4.bin\")\nsurfB = load_pts(\"/tmp/opencode/surfB_t4.bin\")\nprint(f\"surfA={len(surfA)}, surfB={len(surfB)}\")\n\n# Print top-down (X vs Y) ASCII with Z-height digit (0..9) for A and B separately!\nfor name, pts in [(\"TUBE_A (fixed)\", surfA), (\"TUBE_B (initial)\", surfB)]:\n    print(f\"=== {name} (X horizontal -0.1..2.7, Y vertical -0.3..1.6, digit = Z in dm) ===\")\n    grid = {}\n    for x, y, z in pts:\n        gx = int((x + 0.15) / 0.04)\n        gy = int((y + 0.30) / 0.05)\n        z_digit = max(0, min(9, int(round((z + 0.20) * 10))))\n        if (gx, gy) not in grid or z_digit > grid[(gx, gy)]:\n            grid[(gx, gy)] = z_digit\n    for gy in range(38, -1, -1):\n        y_val = -0.30 + gy * 0.05\n        row = \"\".join(str(grid[(gx, gy)]) if (gx, gy) in grid else \".\" for gx in range(73))\n        if any(c != \".\" for c in row):\n            print(f\"y={y_val:+.2f} | {row}\")\n'" action.permission=* action.action=allow action.pattern=*
