ows = decode_png(url)\n        print(f'=== VIEW: {view} ({w}x{h}) | {p[\\\"state\\\"][\\\"output\\\"]} ===')\n        # Sample background from corner\n        bg = tuple(rows[0][0:3])\n        out = []\n        sy, sx = max(1, h // 32), max(1, w // 64)\n        for y in range(0, h, sy):\n            line_ch = []\n            for x in range(0, w, sx):\n                r, g, b = rows[y][x*bpp : x*bpp+3]\n                if abs(r-bg[0])+abs(g-bg[1])+abs(b-bg[2]) < 25:\n                    line_ch.append('.')\n                elif b > r + 35 and b > g + 15:\n                    line_ch.append('B')\n                elif r > b + 40 and r > g + 30:\n                    line_ch.append('H')\n                else:\n                    line_ch.append('A')\n            s = ''.join(line_ch)\n            if any(c != '.' for c in s):\n                out.append(f'{y:3d}: {s}')\n        print('\\n'.join(out))\n\"" action.permission=* action.action=allow action.pattern=*
