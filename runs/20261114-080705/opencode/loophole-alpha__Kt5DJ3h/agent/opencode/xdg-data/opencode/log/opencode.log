timestamp=2026-11-14T07:13:28.184Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nimport math\nfrom collections import Counter\n\n# High-clearance points right along the center of the channel:\n# (cost, dist, pos, quat)\nwps = [\n    (21.6067, 0.0445, [1.2000, 0.3600, 0.2800], [ 1.0000,  0.0000,  0.0000,  0.0000]),\n    (18.4540, 0.0513, [0.9340, 0.0970, 0.4230], [ 0.5815, -0.5204, -0.3089, -0.5438]),\n    (17.4154, 0.0580, [0.7919, 0.0927, 0.4596], [ 0.3205, -0.4933, -0.3771, -0.7154]),\n    (15.5550, 0.1328, [0.1502, 0.3907, 0.5202], [-0.2831, -0.6104, -0.4150, -0.6124]),\n    (13.9202, 0.0729, [0.3082, 0.4787, 0.3022], [-0.6845, -0.5594, -0.3111, -0.3488]),\n]\n\ndef qrot(q, v):\n    w, x, y, z = q\n    # R(q) * v\n    tx = 2*(y*v[2] - z*v[1])\n    ty = 2*(z*v[0] - x*v[2])\n    tz = 2*(x*v[1] - y*v[0])\n    return [\n        v[0] + w*tx + (y*tz - z*ty),\n        v[1] + w*ty + (z*tx - x*tz),\n        v[2] + w*tz + (x*ty - y*tx),\n    ]\n\n# Find c_local such that p_i + R(q_i) * c_local (= world position of pivot point on tube_b!) has MINIMUM variance / smooth motion!\nbest = (1e9, None, None)\nc = [0.0, 0.0, 0.0]\nstep = 0.2\ndef loss(c):\n    world_pts = [[wps[i][2][j] + qrot(wps[i][3], c)[j] for j in range(3)] for i in range(len(wps))]\n    mean = [sum(p[j] for p in world_pts)/len(wps) for j in range(3)]\n    return sum((p[j]-mean[j])**2 for p in world_pts for j in range(3))\n\ncur = loss(c)\nfor _ in range(5000):\n    imp = False\n    for j in range(3):\n        for s in [step, -step]:\n            c2 = list(c); c2[j] += s\n            l2 = loss(c2)\n            if l2 < cur: cur = l2; c = c2; imp = True\n    if not imp: step *= 0.5\n\nprint('Best fixed pivot c_local on tube_b:', [round(x,4) for x in c], 'rms world motion =', round(math.sqrt(cur/len(wps)), 4), 'm!!')\nfor cost, dist, p, q in wps:\n    wp = [p[j] + qrot(q, c)[j] for j in range(3)]\n    print(f'  cost={cost:6.2f} dist={dist:.4f} -> pivot_world={[round(x,4) for x in wp]}')\n\n# Also compute 1-step back from Action 89 ([0.44653, 0.49472, 0.20946], [-0.75109, -0.54664, -0.24098, -0.28103])\n# back to Action 83 ([0.30819, 0.47873, 0.30223], [-0.68454, -0.55944, -0.31108, -0.34881]):\np89 = [0.44653, 0.49472, 0.20946]; q89 = [-0.75109, -0.54664, -0.24098, -0.28103]\np83 = [0.30819, 0.47873, 0.30223]; q83 = [-0.68454, -0.55944, -0.31108, -0.34881]\ndef qmul(a, b):\n    return [a[0]*b[0]-a[1]*b[1]-a[2]*b[2]-a[3]*b[3], a[0]*b[1]+a[1]*b[0]+a[2]*b[3]-a[3]*b[2], a[0]*b[2]-a[1]*b[3]+a[2]*b[0]+a[3]*b[1], a[0]*b[3]+a[1]*b[2]-a[2]*b[1]+a[3]*b[0]]\ndq = qmul(q83, [q89[0], -q89[1], -q89[2], -q89[3]])\nif dq[0] < 0: dq = [-x for x in dq]\ns = math.sqrt(dq[1]**2 + dq[2]**2 + dq[3]**2)\nang = 2 * math.atan2(s, dq[0])\nrot = [ang*dq[1]/s, ang*dq[2]/s, ang*dq[3]/s]\ndp = [p83[i]-p89[i] for i in range(3)]\nprint('A89 -> A83 dp:', [round(x,4) for x in dp], 'norm=', round(math.hypot(*dp),4), 'rot:', [round(x,4) for x in rot], 'norm=', round(ang,4))\n\nlines = open('/proc/8944/net/tcp').readlines()[1:]\nprint('Sockets:', Counter((l.split()[2], l.split()[3]) for l in lines))\n\"" action.permission=* action.action=allow action.pattern=*
