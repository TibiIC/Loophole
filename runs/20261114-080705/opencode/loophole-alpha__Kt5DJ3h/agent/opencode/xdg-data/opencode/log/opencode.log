timestamp=2026-11-14T06:44:27.590Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nimport math\n\nf0 = 21.60665698080951\nrobs = [\n    ( 0.05,  0.00,  0.00, 21.671133816921664),\n    (-0.05,  0.00,  0.00, 21.61166193128063),\n    ( 0.00,  0.05,  0.00, 21.670066228433402),\n    ( 0.00, -0.05,  0.00, 21.623251009101278),\n    ( 0.00,  0.00,  0.05, 21.67584),\n]\n\nfor wr in [0.5, 0.79195, 1.0, 1.2, 1.4, 1.5, 1.5839, 1.583906, 1.6, 2.0]:\n    q = [-0.03, -0.02, -0.02]\n    step = 0.01\n    def loss_r(q, wr):\n        r0 = math.sqrt(q[0]**2 + q[1]**2 + q[2]**2)\n        tot = 0.0\n        for orl, opi, oyw, of in robs:\n            # exact SO(3) angle or Euclidean small-angle:\n            d = math.sqrt((orl-q[0])**2 + (opi-q[1])**2 + (oyw-q[2])**2)\n            tot += ((f0 + wr * (d - r0)) - of)**2\n        return tot\n    cur = loss_r(q, wr)\n    for _ in range(10000):\n        imp = False\n        for j in range(3):\n            for s in [step, -step]:\n                q2 = list(q); q2[j] += s\n                l2 = loss_r(q2, wr)\n                if l2 < cur: cur = l2; q = q2; imp = True\n        if not imp: step *= 0.5\n    print(f'wr={wr:.6f}: rmse={math.sqrt(cur/5):.8f} theta1={[round(x,6) for x in q]} |theta1|={math.sqrt(sum(x*x for x in q)):.6f}')\n\"" action.permission=* action.action=allow action.pattern=*
