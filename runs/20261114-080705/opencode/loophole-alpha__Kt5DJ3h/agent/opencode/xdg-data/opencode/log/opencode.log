timestamp=2026-11-14T06:57:28.294Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nimport math\nfrom collections import Counter\n\nf0 = 17.792623878431552\nd0 = 0.01865\n\n# Translation vertices relative to base [0.878, 0.041, 0.453]:\n# v1=(+5,+5,+5)mm, v2=(+5,-5,-5)mm, v3=(-5,+5,-5)mm, v4=(-5,-5,+5)mm\ntobs = [\n    ( 0.005,  0.005,  0.005, 17.79471, 0.02206),\n    ( 0.005, -0.005, -0.005, 17.79938, 0.01217),\n    (-0.005,  0.005, -0.005, 17.78566, 0.01561),\n    (-0.005, -0.005,  0.005, 17.79129, 0.02474),\n]\n# Exact linear gradient on regular tetrahedron: df/dx = (f1+f2-f3-f4)/(4*0.005)\ngx = (tobs[0][3]+tobs[1][3]-tobs[2][3]-tobs[3][3]) / 0.020\ngy = (tobs[0][3]-tobs[1][3]+tobs[2][3]-tobs[3][3]) / 0.020\ngz = (tobs[0][3]-tobs[1][3]-tobs[2][3]+tobs[3][3]) / 0.020\ncx = (tobs[0][4]+tobs[1][4]-tobs[2][4]-tobs[3][4]) / 0.020\ncy = (tobs[0][4]-tobs[1][4]+tobs[2][4]-tobs[3][4]) / 0.020\ncz = (tobs[0][4]-tobs[1][4]-tobs[2][4]+tobs[3][4]) / 0.020\nprint(f'Trans grad cost_to_go: ({gx:.4f}, {gy:.4f}, {gz:.4f}) | -grad = ({-gx:.4f}, {-gy:.4f}, {-gz:.4f}) | norm={math.hypot(gx,gy,gz):.4f}')\nprint(f'Trans grad clearance : ({cx:.4f}, {cy:.4f}, {cz:.4f})')\n\n# Rotation vertices relative to base quat:\n# Note: Move 5: (+5,+5,+5)mrad -> u1=(+5,+5,+5)\n# Move 6: (0,-10,-10) -> u2=(+5,-5,-5)\n# Move 7: (-10,+10,0) -> u3=(-5,+5,-5)\n# Move 8: (0,-10,+10) -> u4=(-5,-5,+5) (WAIT: check order of args in Move 7: dpitch=+0.01, droll=-0.01, dyaw=0 -> YES u3=(-5,+5,-5)! Move 8: dpitch=-0.01, droll=0, dyaw=+0.01 -> YES u4=(-5,-5,+5)!)\nrobs = [\n    ( 0.005,  0.005,  0.005, 17.80157, 0.02009),\n    ( 0.005, -0.005, -0.005, 17.78249, 0.01958),\n    (-0.005,  0.005, -0.005, 17.79921, 0.01690),\n    (-0.005, -0.005,  0.005, 17.78890, 0.01797),\n]\ngr = (robs[0][3]+robs[1][3]-robs[2][3]-robs[3][3]) / 0.020\ngp = (robs[0][3]-robs[1][3]+robs[2][3]-robs[3][3]) / 0.020\ngyw= (robs[0][3]-robs[1][3]-robs[2][3]+robs[3][3]) / 0.020\ncr = (robs[0][4]+robs[1][4]-robs[2][4]-robs[3][4]) / 0.020\ncp = (robs[0][4]-robs[1][4]+robs[2][4]-robs[3][4]) / 0.020\ncyw= (robs[0][4]-robs[1][4]-robs[2][4]+robs[3][4]) / 0.020\nprint(f'Rot   grad cost_to_go: ({gr:.4f}, {gp:.4f}, {gyw:.4f}) | -grad = ({-gr:.4f}, {-gp:.4f}, {-gyw:.4f}) | norm/1.5839={math.hypot(gr,gp,gyw)/1.5839:.4f}')\nprint(f'Rot   grad clearance : ({cr:.4f}, {cp:.4f}, {cyw:.4f})')\n\nlines = open('/proc/8944/net/tcp').readlines()[1:]\nprint('Sockets:', Counter((l.split()[2], l.split()[3]) for l in lines))\n\"" action.permission=* action.action=allow action.pattern=*
