timestamp=2026-11-14T07:43:44.353Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nimport math\nfrom collections import Counter\n\np0 = [0.246, 0.83293, -0.03515]\nq0 = [-0.88279, -0.34587, 0.12387, -0.29277]\n\ndata = [\n    (134, [0.246, 0.83293, -0.03515], [-0.88279, -0.34587, 0.12387, -0.29277], 11.56679, 0.01364),\n    (135, [0.246, 0.83293, -0.03515], [-0.88393, -0.34480, 0.12262, -0.29112], 11.57062, 0.01764),\n    (136, [0.249, 0.82993, -0.03815], [-0.88393, -0.34480, 0.12262, -0.29112], 11.56757, 0.02121),\n    (137, [0.252, 0.83293, -0.03515], [-0.88393, -0.34480, 0.12262, -0.29112], 11.56480, 0.01891),\n    (138, [0.252, 0.83293, -0.03515], [-0.88316, -0.34674, 0.12121, -0.29174], 11.56412, 0.01956),\n    (139, [0.249, 0.83593, -0.03815], [-0.88316, -0.34674, 0.12121, -0.29174], 11.56606, 0.02186),\n    (140, [0.249, 0.83593, -0.03815], [-0.88289, -0.34745, 0.12350, -0.29075], 11.55871, 0.01847),\n]\n\ndef qmul(a, b):\n    return [a[0]*b[0]-a[1]*b[1]-a[2]*b[2]-a[3]*b[3], a[0]*b[1]+a[1]*b[0]+a[2]*b[3]-a[3]*b[2], a[0]*b[2]-a[1]*b[3]+a[2]*b[0]+a[3]*b[1], a[0]*b[3]+a[1]*b[2]-a[2]*b[1]+a[3]*b[0]]\n\nobs = []\nfor act, p, q, c, d in data:\n    dp = [round(p[i]-p0[i], 5) for i in range(3)]\n    dq = qmul(q, [q0[0], -q0[1], -q0[2], -q0[3]])\n    if dq[0] < 0: dq = [-x for x in dq]\n    s = math.sqrt(dq[1]**2 + dq[2]**2 + dq[3]**2)\n    ang = 2 * math.atan2(s, dq[0])\n    rot = [round(ang*dq[i]/s, 5) if s>1e-8 else 0.0 for i in (1,2,3)]\n    obs.append((dp, rot, c, d))\n    print(f'A{act}: dp={dp} rot={rot} cost={c:.5f} dist={d:.5f}')\n\n# Exact linear gradients from pairs with identical rot or identical dp!!\n# Same rot (A135, A136, A137):\n# A135: dp=(0, 0, 0),       c=11.57062, d=0.01764\n# A137: dp=(0.006, 0, 0),   c=11.56480, d=0.01891 => gx = (11.56480-11.57062)/0.006 = -0.9700!! cx = +0.2117!!\n# A136: dp=(0.003,-0.003,-0.003), c=11.56757, d=0.02121\n# Same rot (A138, A139):\n# A138: dp=(0.006, 0, 0),         c=11.56412, d=0.01956\n# A139: dp=(0.003, 0.003,-0.003), c=11.56606, d=0.02186\n# Solve (gx, gy, gz) from A135, A136, A137, A138, A139!!\ngx = (11.56480 - 11.57062) / 0.006\n# A136 - A135 = 0.003*gx - 0.003*gy - 0.003*gz = -0.00305\n# A139 - A138 = -0.003*gx + 0.003*gy - 0.003*gz = +0.00194\n# Add them: -0.006*gz = -0.00111 => gz = +0.1850!!\ngz = ((11.56757 - 11.57062) + (11.56606 - 11.56412)) / (-0.006)\ngy = (0.003*gx - 0.003*gz - (11.56757 - 11.57062)) / 0.003\ncx = (0.01891 - 0.01764) / 0.006\ncz = ((0.02121 - 0.01764) + (0.02186 - 0.01956)) / (-0.006)\ncy = (0.003*cx - 0.003*cz - (0.02121 - 0.01764)) / 0.003\nprint(f'Trans -grad cost: ({-gx:.4f}, {-gy:.4f}, {-gz:.4f}) norm={math.hypot(gx,gy,gz):.4f}')\nprint(f'Trans  grad dist: ({cx:.4f}, {cy:.4f}, {cz:.4f}) norm={math.hypot(cx,cy,cz):.4f}')\n\n# Same dp for rot:\n# A134->A135 (dp=0): rot=(-0.003, +0.003, -0.003) -> dc = +0.00383, dd = +0.00400\n# A137->A138 (dp=(6,0,0)): rot_diff = (+0.003, -0.003, -0.003) -> dc = -0.00068, dd = +0.00065\n# A139->A140 (dp=(3,3,-3)): rot_diff = (+0.003, +0.003, +0.003) -> dc = -0.00735, dd = -0.00339!!\nwr = 1.5839\n# Solve 3x3 for (gr, gp, gyw):\n# -gr + gp - gyw =  0.00383 / 0.003 =  1.2767\n#  gr - gp - gyw = -0.00068 / 0.003 = -0.2267\n#  gr + gp + gyw = -0.00735 / 0.003 = -2.4500\ngyw = (1.2767 + (-0.2267)) / (-2.0) # -0.5250\ngr = (-0.2267 + (-2.4500)) / 2.0    # -1.3383\ngp = -2.4500 - gr - gyw             # -0.5867\ncyw = (0.00400/0.003 + 0.00065/0.003) / (-2.0)\ncr  = (0.00065/0.003 + (-0.00339)/0.003) / 2.0\ncp  = -0.00339/0.003 - cr - cyw\nprint(f'Rot -grad/wr: ({-gr/wr:.4f}, {-gp/wr:.4f}, {-gyw/wr:.4f}) norm={math.hypot(gr,gp,gyw)/wr:.4f}')\nprint(f'Rot  grad dist: ({cr:.4f}, {cp:.4f}, {cyw:.4f})')\n\nlines = open('/proc/8944/net/tcp').readlines()[1:]\nprint('Sockets:', Counter((l.split()[2], l.split()[3]) for l in lines))\n\"" action.permission=* action.action=allow action.pattern=*
