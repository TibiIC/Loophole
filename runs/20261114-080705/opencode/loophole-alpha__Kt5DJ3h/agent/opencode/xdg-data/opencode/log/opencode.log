timestamp=2026-11-14T07:01:50.351Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nimport math\nfrom collections import Counter\n\nf0 = 17.41543\nrobs = [\n    ( 0.008,  0.008,  0.008, 17.4342823267, 0.05577),\n    ( 0.008, -0.008, -0.008, 17.41067,      0.05369),\n    (-0.008,  0.008, -0.008, 17.40116,      0.06051),\n    (-0.008, -0.008,  0.008, 17.41862,      0.06209),\n]\ngr = (robs[0][3]+robs[1][3]-robs[2][3]-robs[3][3]) / 0.032\ngp = (robs[0][3]-robs[1][3]+robs[2][3]-robs[3][3]) / 0.032\ngyw= (robs[0][3]-robs[1][3]-robs[2][3]+robs[3][3]) / 0.032\nprint(f'Rot -grad: ({-gr:.4f}, {-gp:.4f}, {-gyw:.4f}) | /1.5839 = ({-gr/1.5839:.4f}, {-gp/1.5839:.4f}, {-gyw/1.5839:.4f}) norm/1.5839={math.hypot(gr,gp,gyw)/1.5839:.4f}')\navg_df = sum(r[3] for r in robs)/4 - f0\nprint('Rot avg_df =', avg_df)\n\n# FIT EXACT WAYPOINT theta1 = (r1, p1, yw1) to f0 + 1.5839*(||u - theta1|| - ||theta1||)!!\nwr = 1.5839\nq = [-0.03, -0.01, -0.03]\nstep = 0.01\ndef loss_r(q):\n    r0 = math.sqrt(q[0]**2 + q[1]**2 + q[2]**2)\n    tot = 0.0\n    for u1, u2, u3, of, _ in robs:\n        d = math.sqrt((u1-q[0])**2 + (u2-q[1])**2 + (u3-q[2])**2)\n        tot += ((f0 + wr*(d - r0)) - of)**2\n    return tot\ncur = loss_r(q)\nfor _ in range(10000):\n    imp = False\n    for j in range(3):\n        for s in [step, -step]:\n            q2 = list(q); q2[j] += s\n            l2 = loss_r(q2)\n            if l2 < cur: cur = l2; q = q2; imp = True\n    if not imp: step *= 0.5\nprint('Exact theta1 from Action 41:', [round(x,5) for x in q], '|theta1|=', round(math.hypot(*q),5), 'rmse=', math.sqrt(cur/4))\n\n# AND FIT EXACT WAYPOINT p1 = (x1, y1, z1) to Actions 41..45 AND Action 40!!\ntobs = [\n    ( 0.008,  0.008,  0.008, 17.41851),\n    ( 0.008, -0.008, -0.008, 17.42645),\n    (-0.008,  0.008, -0.008, 17.40413),\n    (-0.008, -0.008,  0.008, 17.41484),\n]\np = [-0.09, 0.06, -0.01]\nstep = 0.01\ndef loss_p(p):\n    r0 = math.sqrt(p[0]**2 + p[1]**2 + p[2]**2)\n    tot = 0.0\n    for v1, v2, v3, of in tobs:\n        d = math.sqrt((v1-p[0])**2 + (v2-p[1])**2 + (v3-p[2])**2)\n        tot += ((f0 + d - r0) - of)**2\n    return tot\ncur = loss_p(p)\nfor _ in range(10000):\n    imp = False\n    for j in range(3):\n        for s in [step, -step]:\n            p2 = list(p); p2[j] += s\n            l2 = loss_p(p2)\n            if l2 < cur: cur = l2; p = p2; imp = True\n    if not imp: step *= 0.5\nprint('Exact p1 from Action 41:', [round(x,5) for x in p], '|p1|=', round(math.hypot(*p),5), 'rmse=', math.sqrt(cur/4))\n\nlines = open('/proc/8944/net/tcp').readlines()[1:]\nprint('Sockets:', Counter((l.split()[2], l.split()[3]) for l in lines))\n\"" action.permission=* action.action=allow action.pattern=*
