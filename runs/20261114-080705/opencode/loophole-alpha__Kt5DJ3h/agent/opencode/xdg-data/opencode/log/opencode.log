timestamp=2026-11-14T07:28:01.893Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nimport math\nfrom collections import Counter\n\n# Look at A118, A119, A120 (all same quat!):\n# A118: (0.000,  0.000,  0.000) -> f = 12.25219987, d = 0.03454\n# A119: (0.006, -0.006, -0.006) -> f = 12.24340,    d = 0.02748\n# A120: (0.000,  0.000, -0.012) -> f = 12.24731,    d = 0.03399\n# WAIT A SECOND!! Look at A120 vs A118: dz = -0.012 ALONE dropped f by -0.00489 (gz = +0.4075 -> -gz = -0.4075)!\n# And A119 vs mid(A118,A120): (0.006, -0.006, -0.006) vs (0, 0, -0.006):\n# f(0,0,-0.006) ~ (12.25220 + 12.24731)/2 = 12.249755!\n# A119 is 12.24340 - 12.249755 = -0.006355 for (dx=+0.006, dy=-0.006)!!\n# WAIT A SECOND!! ||(0.006, -0.006, -0.006)|| = 0.010392 m, and f dropped by -0.00880 m (85% OF FULL NORM)!!\n# THAT MEANS (+x, -y, -z) IS GOING **BACK DOWN Y** (dy < 0) AND (+x, -z)!!\nprint('df(A118->A119) =', 12.24340 - 12.25220, 'out of -0.01039 max!! Ratio =', (12.25220-12.24340)/0.010392)\n\n# Now check rotation at A120 (f_base = 12.24731):\n# A120: (0.000, 0.000,  0.000) -> f = 12.24731, d = 0.03399\n# A121: (0.006, 0.006,  0.006) -> f = 12.25601, d = 0.03533\n# A122: (0.012, 0.000,  0.000) -> f = 12.24803, d = 0.03478\n# A123: (0.006, 0.006, -0.006) -> f = 12.25772, d = 0.03345\nf20 = 12.24731\nwr = 1.5839\ngr = (12.24803 - f20) / 0.012\ngyw = (12.25601 - 12.25772) / 0.012\ngp = ((12.25601 + 12.25772)/2 - f20 - gr*0.006) / 0.006\nprint(f'Rot -grad/wr at W6: ({-gr/wr:.4f}, {-gp/wr:.4f}, {-gyw/wr:.4f}) norm={math.hypot(gr,gp,gyw)/wr:.4f}')\nrobs = [(0.006,0.006,0.006,12.25601), (0.012,0,0,12.24803), (0.006,0.006,-0.006,12.25772)]\nq = [0.005, -0.05, 0.01]\nstep = 0.01\ndef loss_r(q):\n    r0 = math.hypot(*q)\n    return sum(((f20 + wr*(math.hypot(ox-q[0], oy-q[1], oz-q[2]) - r0)) - of)**2 for ox,oy,oz,of in robs)\ncur = loss_r(q)\nfor _ in range(10000):\n    imp = False\n    for j in range(3):\n        for s in [step, -step]:\n            q2 = list(q); q2[j] += s\n            l2 = loss_r(q2)\n            if l2 < cur: cur = l2; q = q2; imp = True\n    if not imp: step *= 0.5\nprint('Exact theta1 at A120:', [round(x,5) for x in q], '|theta1|=', round(math.hypot(*q),5), 'rmse=', math.sqrt(cur/3))\n\nlines = open('/proc/8944/net/tcp').readlines()[1:]\nprint('Sockets:', Counter((l.split()[2], l.split()[3]) for l in lines))\n\"" action.permission=* action.action=allow action.pattern=*
