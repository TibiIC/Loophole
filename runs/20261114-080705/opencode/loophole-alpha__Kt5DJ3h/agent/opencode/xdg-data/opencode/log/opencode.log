timestamp=2026-11-14T07:15:59.068Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nimport math\nfrom collections import Counter\n\np0 = [0.36453, 0.48472, 0.26446]\nq0 = [-0.70297, -0.55621, -0.29603, -0.32989]\nf0 = 13.912813333586339\n\n# Translation probes A90(base), A91, A92, A93, A94:\ntobs = [\n    (0.00, 0.00, 0.00, f0,       0.07957),\n    (0.01, 0.01, 0.01, 13.91617, 0.09318),\n    (0.02, 0.00, 0.00, 13.92337, 0.07965),\n    (0.01, 0.01,-0.01, 13.90628, 0.07561),\n]\n# Fit exact waypoint p1:\np = [-0.02, 0.02, -0.02]\nstep = 0.01\ndef loss_p(p):\n    r0 = math.hypot(*p)\n    return sum(((f0 + math.hypot(ox-p[0], oy-p[1], oz-p[2]) - r0) - of)**2 for ox,oy,oz,of,_ in tobs[1:])\ncur = loss_p(p)\nfor _ in range(10000):\n    imp = False\n    for j in range(3):\n        for s in [step, -step]:\n            p2 = list(p); p2[j] += s\n            l2 = loss_p(p2)\n            if l2 < cur: cur = l2; p = p2; imp = True\n    if not imp: step *= 0.5\nprint('Exact p1:', [round(x,5) for x in p], '|p1|=', round(math.hypot(*p),5), 'rmse=', math.sqrt(cur/3))\n# Linear gradient check:\ngx = (13.92337 - f0) / 0.02\ngz = (13.91617 - 13.90628) / 0.02\ngy = ((13.91617 + 13.90628)/2 - f0 - gx*0.01) / 0.01\nprint(f'Trans -grad: ({-gx:.4f}, {-gy:.4f}, {-gz:.4f}) norm={math.hypot(gx,gy,gz):.4f}')\n\n# Rotation probes A94(base), A95, A96, A97, A98:\n# A95: (+0.01, +0.01, +0.01) -> 13.92297\n# A96: (+0.02,  0.00,  0.00) -> 13.91271\n# A97: (+0.01, +0.01, -0.01) -> 13.93190\n# A98: ( 0.00,  0.00,  0.00) -> 13.91252\nrobs = [\n    (0.01, 0.01, 0.01, 13.92297),\n    (0.02, 0.00, 0.00, 13.91271),\n    (0.01, 0.01,-0.01, 13.93190),\n]\nwr = 1.5839\nq = [0.02, -0.03, 0.02]\nstep = 0.01\ndef loss_r(q):\n    r0 = math.hypot(*q)\n    return sum(((f0 + wr*(math.hypot(ox-q[0], oy-q[1], oz-q[2]) - r0)) - of)**2 for ox,oy,oz,of in robs)\ncur = loss_r(q)\nfor _ in range(10000):\n    imp = False\n    for j in range(3):\n        for s in [step, -step]:\n            q2 = list(q); q2[j] += s\n            l2 = loss_r(q2)\n            if l2 < cur: cur = l2; q = q2; imp = True\n    if not imp: step *= 0.5\nprint('Exact theta1:', [round(x,5) for x in q], '|theta1|=', round(math.hypot(*q),5), 'rmse=', math.sqrt(cur/3))\ngr = (13.91271 - f0) / 0.02\ngyw = (13.92297 - 13.93190) / 0.02\ngp = ((13.92297 + 13.93190)/2 - f0 - gr*0.01) / 0.01\nprint(f'Rot -grad/wr: ({-gr/wr:.4f}, {-gp/wr:.4f}, {-gyw/wr:.4f}) norm={math.hypot(gr,gp,gyw)/wr:.4f}')\n\nlines = open('/proc/8944/net/tcp').readlines()[1:]\nprint('Sockets:', Counter((l.split()[2], l.split()[3]) for l in lines))\n\"" action.permission=* action.action=allow action.pattern=*
