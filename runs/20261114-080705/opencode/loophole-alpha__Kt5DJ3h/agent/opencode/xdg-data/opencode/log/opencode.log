            continue\n                        mA, mB = views[v][2][py][px], views[v][3][py][px]\n                        if not (mA or mB): ok = False; break\n                        if mA: cA += 1\n                        if mB: cB += 1\n                    if ok and (cA + cB == 4):\n                        pts.append((x,y,z))\n                        if cA >= 3: ptsA.append((x,y,z))\n                        if cB >= 3: ptsB.append((x,y,z))\n        print(f'sign={sign}: total={len(pts)}, A={len(ptsA)}, B={len(ptsB)}')\n        for name, P in [('A', ptsA), ('B', ptsB)]:\n            if P:\n                xs, ys, zs = zip(*P)\n                print(f'  {name} bbox: x=[{min(xs):.2f},{max(xs):.2f}] y=[{min(ys):.2f},{max(ys):.2f}] z=[{min(zs):.2f},{max(zs):.2f}]')\n\"" action.permission=* action.action=allow action.pattern=*
