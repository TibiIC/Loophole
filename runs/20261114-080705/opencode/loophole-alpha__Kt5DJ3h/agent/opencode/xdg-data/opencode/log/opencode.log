timestamp=2026-11-14T07:23:46.146Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nimport math\nfrom collections import Counter\n\nf0 = 12.382543189178952\nd0 = 0.02465\n\n# Trans probes A106, A107, A108:\n# A106: (+0.004, +0.004, +0.004) -> f=12.38168, d=0.02166\n# A107: (+0.008,  0.000,  0.000) -> f=12.37573, d=0.02717\n# A108: (+0.004, +0.004, -0.004) -> f=12.37760, d=0.02919\ngx = (12.37573 - f0) / 0.008\ngz = (12.38168 - 12.37760) / 0.008\ngy = ((12.38168 + 12.37760)/2 - f0 - gx*0.004) / 0.004\ncx = (0.02717 - d0) / 0.008\ncz = (0.02166 - 0.02919) / 0.008\ncy = ((0.02166 + 0.02919)/2 - d0 - cx*0.004) / 0.004\nprint(f'Trans -grad cost: ({-gx:.4f}, {-gy:.4f}, {-gz:.4f}) norm={math.hypot(gx,gy,gz):.4f}')\nprint(f'Trans  grad dist: ({cx:.4f}, {cy:.4f}, {cz:.4f}) norm={math.hypot(cx,cy,cz):.4f}')\n\n# Fit exact waypoint p1:\ntobs = [(0.004,0.004,0.004,12.38168), (0.008,0,0,12.37573), (0.004,0.004,-0.004,12.37760)]\np = [0.05, 0.01, -0.03]\nstep = 0.01\ndef loss_p(p):\n    r0 = math.hypot(*p)\n    return sum(((f0 + math.hypot(ox-p[0], oy-p[1], oz-p[2]) - r0) - of)**2 for ox,oy,oz,of in tobs)\ncur = loss_p(p)\nfor _ in range(10000):\n    imp = False\n    for j in range(3):\n        for s in [step, -step]:\n            p2 = list(p); p2[j] += s\n            l2 = loss_p(p2)\n            if l2 < cur: cur = l2; p = p2; imp = True\n    if not imp: step *= 0.5\nprint('Exact p1:', [round(x,5) for x in p], '|p1|=', round(math.hypot(*p),5), 'rmse=', math.sqrt(cur/3))\n\n# Rot probes A110, A111, A112:\n# A110: (+0.004, +0.004, +0.004) -> f=12.38742, d=0.02736\n# A111: (+0.008,  0.000,  0.000) -> f=12.38206, d=0.02921\n# A112: (+0.004, +0.004, -0.004) -> f=12.38934, d=0.02573\nwr = 1.5839\ngr = (12.38206 - f0) / 0.008\ngyw = (12.38742 - 12.38934) / 0.008\ngp = ((12.38742 + 12.38934)/2 - f0 - gr*0.004) / 0.004\ncr = (0.02921 - d0) / 0.008\ncyw = (0.02736 - 0.02573) / 0.008\ncp = ((0.02736 + 0.02573)/2 - d0 - cr*0.004) / 0.004\nprint(f'Rot -grad/wr: ({-gr/wr:.4f}, {-gp/wr:.4f}, {-gyw/wr:.4f}) norm={math.hypot(gr,gp,gyw)/wr:.4f}')\nprint(f'Rot  grad dist: ({cr:.4f}, {cp:.4f}, {cyw:.4f})')\n\nrobs = [(0.004,0.004,0.004,12.38742), (0.008,0,0,12.38206), (0.004,0.004,-0.004,12.38934)]\nq = [0.01, -0.05, 0.01]\nstep = 0.01\ndef loss_r(q):\n    r0 = math.hypot(*q)\n    return sum(((f0 + wr*(math.hypot(ox-q[0], oy-q[1], oz-q[2]) - r0)) - of)**2 for ox,oy,oz,of in robs)\ncur = loss_r(q)\nfor _ in range(10000):\n    imp = False\n    for j in range(3):\n        for s in [step, -step]:\n            q2 = list(q); q2[j] += s\n            l2 = loss_r(q2)\n            if l2 < cur: cur = l2; q = q2; imp = True\n    if not imp: step *= 0.5\nprint('Exact theta1:', [round(x,5) for x in q], '|theta1|=', round(math.hypot(*q),5), 'rmse=', math.sqrt(cur/3))\n\nlines = open('/proc/8944/net/tcp').readlines()[1:]\nprint('Sockets:', Counter((l.split()[2], l.split()[3]) for l in lines))\n\"" action.permission=* action.action=allow action.pattern=*
