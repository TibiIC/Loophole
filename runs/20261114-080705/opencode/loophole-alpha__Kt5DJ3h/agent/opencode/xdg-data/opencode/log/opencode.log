timestamp=2026-11-14T07:10:24.648Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nimport math\nfrom collections import Counter\n\n# Base A71 / A79:\np0 = [-0.00781, 0.45873, 0.53823]\nq0 = [-0.43031, -0.60081, -0.39976, -0.54227]\n\n# Sort A71..A79 by action number and inspect exact (dp, drot) from (p0, q0), cost, and clearance!!\ndata = [\n    (71, [-0.00781, 0.45873, 0.53823], [-0.43030, -0.60082, -0.39976, -0.54226], 15.04843, 0.02002),\n    (72, [-0.01181, 0.45473, 0.54223], [-0.43030, -0.60082, -0.39976, -0.54226], 15.05452, 0.01384),\n    (73, [-0.01181, 0.45473, 0.54223], [-0.42721, -0.60196, -0.40074, -0.54271], 15.18851, 0.01549),\n    (74, [-0.01581, 0.45873, 0.53823], [-0.42721, -0.60196, -0.40074, -0.54271], 15.18915, 0.01740),\n    (75, [-0.01181, 0.46273, 0.54223], [-0.42721, -0.60196, -0.40074, -0.54271], 15.18813, 0.01701),\n    (76, [-0.00781, 0.45873, 0.53823], [-0.42721, -0.60196, -0.40074, -0.54271], 15.18270, 0.02169),\n    (77, [-0.00781, 0.45873, 0.53823], [-0.42790, -0.60252, -0.39760, -0.54386], 15.17801, 0.02273),\n    (78, [-0.00781, 0.45873, 0.53823], [-0.42938, -0.60355, -0.39834, -0.54100], 15.05239, 0.02015),\n    (79, [-0.00781, 0.45873, 0.53823], [-0.43031, -0.60081, -0.39976, -0.54227], 15.04838, 0.02002),\n]\n\ndef qmul(a, b):\n    return [\n        a[0]*b[0] - a[1]*b[1] - a[2]*b[2] - a[3]*b[3],\n        a[0]*b[1] + a[1]*b[0] + a[2]*b[3] - a[3]*b[2],\n        a[0]*b[2] - a[1]*b[3] + a[2]*b[0] + a[3]*b[1],\n        a[0]*b[3] + a[1]*b[2] - a[2]*b[1] + a[3]*b[0],\n    ]\n\nfor act, p, q, c, d in data:\n    dp = [round(p[i]-p0[i], 5) for i in range(3)]\n    dq = qmul(q, [q0[0], -q0[1], -q0[2], -q0[3]])\n    if dq[0] < 0: dq = [-x for x in dq]\n    s = math.sqrt(dq[1]**2 + dq[2]**2 + dq[3]**2)\n    ang = 2 * math.atan2(s, dq[0])\n    rot = [round(ang*dq[i]/s, 5) if s>1e-8 else 0.0 for i in (1,2,3)]\n    print(f'A{act}: dp={dp} rot={rot} cost={c:.5f} dist={d:.5f}')\n\n# Look at A73, A74, A75, A76: ALL FOUR HAVE IDENTICAL ROTATION (+0.004, +0.004, +0.004)!!\n# SO A73, A74, A75, A76 GIVE PURE TRANSLATION GRADIENT OF BOTH cost AND clearance!!\n# Wait:\n# A73: dp = (-0.004, -0.004, +0.004), cost = 15.18851, dist = 0.01549\n# A74: dp = (-0.008,  0.000,  0.000), cost = 15.18915, dist = 0.01740\n# A75: dp = (-0.004, +0.004, +0.004), cost = 15.18813, dist = 0.01701\n# A76: dp = ( 0.000,  0.000,  0.000), cost = 15.18270, dist = 0.02169\n# Solve exact linear gradient gx*dx + gy*dy + gz*dz = cost - 15.18270 from A73, A74, A75 relative to A76!!\ngx = (15.18915 - 15.18270) / (-0.008)\ngy = (15.18813 - 15.18851) / (0.008)\ngz = ((15.18813 + 15.18851)/2 - 15.18270 - gx*(-0.004)) / 0.004\ncx = (0.01740 - 0.02169) / (-0.008)\ncy = (0.01701 - 0.01549) / (0.008)\ncz = ((0.01701 + 0.01549)/2 - 0.02169 - cx*(-0.004)) / 0.004\nprint(f'Trans -grad cost (from A73-76): ({-gx:.4f}, {-gy:.4f}, {-gz:.4f}) norm={math.hypot(gx,gy,gz):.4f}')\nprint(f'Trans  grad dist (from A73-76): ({cx:.4f}, {cy:.4f}, {cz:.4f}) norm={math.hypot(cx,cy,cz):.4f}')\n\n# Also check A71 -> A72 (at branch 15.048): dp = (-0.004, -0.004, +0.004) gave d_cost = +0.00609, d_dist = -0.00618!\n# Check pred d_cost from (gx,gy,gz): gx*(-0.004) + gy*(-0.004) + gz*(0.004) =\nprint('Check A71->A72 pred d_cost =', gx*(-0.004)+gy*(-0.004)+gz*(0.004), 'actual =', 15.05452 - 15.04843)\nprint('Check A71->A72 pred d_dist =', cx*(-0.004)+cy*(-0.004)+cz*(0.004), 'actual =', 0.01384 - 0.02002)\n\nlines = open('/proc/8944/net/tcp').readlines()[1:]\nprint('Sockets:', Counter((l.split()[2], l.split()[3]) for l in lines))\n\"" action.permission=* action.action=allow action.pattern=*
