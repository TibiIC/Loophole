timestamp=2026-11-14T07:19:31.855Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nfrom collections import Counter\nimport math\n\n# Look at Action 102 (dist = 0.03035 m = 3.04 cm!) vs Action 103 (dist = 0.005 m) vs Action 104 (dist = -0.00022 m):\n# Action 102: p = [0.22453, 0.78472, 0.06446], q = [-0.86281, -0.4442, -0.12006, -0.20933], cost = 12.60238, dist = 0.03035\n# Action 104: p = [0.16332, 0.88140, 0.00009], q = [-0.90212, -0.39679, -0.05069, -0.16179], cost = 12.33511, dist = -0.00022\n# Notice! Step back 70% from A104 towards A102:\np104 = [0.16332, 0.88140, 0.00009]; q104 = [-0.90212, -0.39679, -0.05069, -0.16179]\np102 = [0.22453, 0.78472, 0.06446]; q102 = [-0.86281, -0.44420, -0.12006, -0.20933]\ndp = [0.75*(p102[i]-p104[i]) for i in range(3)]\ndef qmul(a, b):\n    return [a[0]*b[0]-a[1]*b[1]-a[2]*b[2]-a[3]*b[3], a[0]*b[1]+a[1]*b[0]+a[2]*b[3]-a[3]*b[2], a[0]*b[2]-a[1]*b[3]+a[2]*b[0]+a[3]*b[1], a[0]*b[3]+a[1]*b[2]-a[2]*b[1]+a[3]*b[0]]\ndq = qmul(q102, [q104[0], -q104[1], -q104[2], -q104[3]])\nif dq[0] < 0: dq = [-x for x in dq]\ns = math.sqrt(dq[1]**2 + dq[2]**2 + dq[3]**2)\nang = 2 * math.atan2(s, dq[0])\nrot = [0.75*ang*dq[i]/s for i in (1,2,3)]\nprint('Step back dp:', [round(x,4) for x in dp], 'rot:', [round(x,4) for x in rot])\n\nlines = open('/proc/8944/net/tcp').readlines()[1:]\nprint('Sockets:', Counter((l.split()[2], l.split()[3]) for l in lines))\n\"" action.permission=* action.action=allow action.pattern=*
