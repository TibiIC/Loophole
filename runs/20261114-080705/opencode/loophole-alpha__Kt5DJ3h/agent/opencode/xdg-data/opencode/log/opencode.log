timestamp=2026-11-14T08:02:06.145Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nimport math\nfrom collections import Counter\n\n# Look at our clean, centered, high-clearance poses along this entire phase:\n# W6  (c=12.252, d=3.45cm): p=[0.2483, 0.8289,  0.0019], q=[-0.8913, -0.4104, -0.0706, -0.1792]\n# A127(c=11.846, d=2.70cm): p=[0.2892, 0.8380, -0.0497], q=[-0.8918, -0.3860,  0.0220, -0.2350]\n# A149(c=11.494, d=2.22cm): p=[0.2683, 0.8247, -0.0485], q=[-0.8779, -0.3739,  0.1311, -0.2689]\n# W7  (c~11.280, d~3.00cm): p=[0.2839, 0.8370, -0.0440], q=[-0.8628, -0.3935,  0.1747, -0.2649]\n\npts = [\n    (12.252, [0.2483, 0.8289,  0.0019], [-0.8913, -0.4104, -0.0706, -0.1792]),\n    (11.846, [0.2892, 0.8380, -0.0497], [-0.8918, -0.3860,  0.0220, -0.2350]),\n    (11.494, [0.2683, 0.8247, -0.0485], [-0.8779, -0.3739,  0.1311, -0.2689]),\n    (11.280, [0.2839, 0.8370, -0.0440], [-0.8628, -0.3935,  0.1747, -0.2649]),\n]\n\ndef qmul(a, b):\n    return [a[0]*b[0]-a[1]*b[1]-a[2]*b[2]-a[3]*b[3], a[0]*b[1]+a[1]*b[0]+a[2]*b[3]-a[3]*b[2], a[0]*b[2]-a[1]*b[3]+a[2]*b[0]+a[3]*b[1], a[0]*b[3]+a[1]*b[2]-a[2]*b[1]+a[3]*b[0]]\n\nfor i in range(len(pts)-1):\n    c1, p1, q1 = pts[i]\n    c2, p2, q2 = pts[i+1]\n    dp = [p2[j]-p1[j] for j in range(3)]\n    dq = qmul(q2, [q1[0], -q1[1], -q1[2], -q1[3]])\n    if dq[0] < 0: dq = [-x for x in dq]\n    s = math.sqrt(dq[1]**2 + dq[2]**2 + dq[3]**2)\n    ang = 2 * math.atan2(s, dq[0])\n    rot = [ang*dq[j]/s for j in (1,2,3)]\n    dc = c1 - c2\n    print(f'{c1:.2f}->{c2:.2f} (dc={dc:.3f}): dp={[round(x,4) for x in dp]} | rot={[round(x,4) for x in rot]} (|rot|={ang:.4f})')\n\n# ALSO check total from W6 (12.252) to W7 (11.280):\nc1, p1, q1 = pts[0]; c2, p2, q2 = pts[3]\ndp = [p2[j]-p1[j] for j in range(3)]\ndq = qmul(q2, [q1[0], -q1[1], -q1[2], -q1[3]])\nif dq[0] < 0: dq = [-x for x in dq]\ns = math.sqrt(dq[1]**2 + dq[2]**2 + dq[3]**2)\nang = 2 * math.atan2(s, dq[0])\nrot = [ang*dq[j]/s for j in (1,2,3)]\nprint(f'TOTAL 12.25->11.28: dp={[round(x,4) for x in dp]} | rot={[round(x,4) for x in rot]} (|rot|={ang:.4f})')\n\nlines = open('/proc/8944/net/tcp').readlines()[1:]\nprint('Sockets:', Counter((l.split()[2], l.split()[3]) for l in lines))\n\"" action.permission=* action.action=allow action.pattern=*
