timestamp=2026-11-14T06:25:43.933Z level=INFO run=91cee65b message=evaluated permission=bash pattern="python3 -c \"\nimport json, base64, zlib, struct, math\n\ndef decode_png(b64):\n    data = base64.b64decode(b64)\n    pos = 8; w = h = 0; idat = bytearray()\n    while pos < len(data):\n        length, ctype = struct.unpack('>I4s', data[pos:pos+8])\n        chunk = data[pos+8:pos+8+length]; pos += 12 + length\n        if ctype == b'IHDR': w, h, bd, ct, _, _, _ = struct.unpack('>IIBBBBB', chunk)\n        elif ctype == b'IDAT': idat.extend(chunk)\n    raw = zlib.decompress(bytes(idat))\n    bpp = 3 if ct == 2 else 4; stride = w * bpp\n    rows = []; i = 0; prev = bytearray(stride)\n    for y in range(h):\n        f = raw[i]; i += 1; row = bytearray(raw[i:i+stride]); i += stride\n        if f == 1:\n            for x in range(bpp, stride): row[x] = (row[x] + row[x-bpp]) & 255\n        elif f == 2:\n            for x in range(stride): row[x] = (row[x] + prev[x]) & 255\n        elif f == 3:\n            for x in range(stride):\n                a = row[x-bpp] if x >= bpp else 0\n                row[x] = (row[x] + ((a + prev[x]) >> 1)) & 255\n        elif f == 4:\n            for x in range(stride):\n                a = row[x-bpp] if x >= bpp else 0; b = prev[x]; c = prev[x-bpp] if x >= bpp else 0\n                p = a + b - c; pa, pb, pc = abs(p-a), abs(p-b), abs(p-c)\n                pr = a if (pa <= pb and pa <= pc) else (b if pb <= pc else c)\n                row[x] = (row[x] + pr) & 255\n        rows.append(row); prev = row\n    return w, h, bpp, rows\n\nviews = {}\ncams = {\n    'iso': (135, -25),\n    'side': (0, -10),\n    'front': (90, -10),\n    'top': (90, -89),\n}\nlookat = [1.155, 0.746, 0.067]\ndist = 2.76\n\nfor line in open('/logs/agent/opencode.txt'):\n    d = json.loads(line)\n    if d.get('type') == 'tool_use' and d['part']['tool'] == 'loophole_render':\n        p = d['part']\n        v = p['state']['input']['view']\n        url = p['state']['attachments'][0]['url'].split(',', 1)[1]\n        w, h, bpp, rows = decode_png(url)\n        maskA = [[False]*w for _ in range(h)]\n        maskB = [[False]*w for _ in range(h)]\n        for y in range(h):\n            bg_r, bg_g, bg_b = rows[y][0:3]\n            for x in range(w):\n                r, g, b = rows[y][x*bpp:x*bpp+3]\n                if abs(r-bg_r)+abs(g-bg_g)+abs(b-bg_b) < 25 and r > 180:\n                    continue\n                if b > r + 40:\n                    maskB[y][x] = True\n                else:\n                    maskA[y][x] = True\n        views[v] = (w, h, maskA, maskB)\n\nfor sign in [1, -1]:\n    for fovy in [45.0]:\n        cntA = cntB = 0\n        ptsA, ptsB = [], []\n        fy = 180.0 / math.tan(math.radians(fovy/2))\n        for ix in range(-15, 35):\n            x = ix * 0.08\n            for iy in range(-15, 35):\n                y = iy * 0.08\n                for iz in range(-15, 25):\n                    z = iz * 0.08\n                    okA = okB = True\n                    for v, (az, el) in cams.items():\n                        ca, sa = math.cos(math.radians(az)), math.sin(math.radians(az))\n                        ce, se = math.cos(math.radians(el)), math.sin(math.radians(el))\n                        # sign=1: forward = [ca*ce, sa*ce, se]; sign=-1: forward = [-ca*ce, -sa*ce, se]\n                        fw = [sign*ca*ce, sign*sa*ce, se]\n                        # right = fw x [0,0,1] normalized\n                        rx, ry = fw[1]/ce, -fw[0]/ce\n                        ux, uy, uz = -fw[0]*se/ce, -fw[1]*se/ce, ce\n                        cpos = [lookat[0]-dist*fw[0], lookat[1]-dist*fw[1], lookat[2]-dist*fw[2]]\n                        dx, dy, dz = x-cpos[0], y-cpos[1], z-cpos[2]\n                        zc = dx*fw[0] + dy*fw[1] + dz*fw[2]\n                        if zc <= 0.1: okA = okB = False; break\n                        xc = dx*rx + dy*ry\n                        yc = dx*ux + dy*uy + dz*uz\n                        px = int(240 + fy * xc / zc)\n                        py = int(180 - fy * yc / zc)\n                        if not (0 <= px < 480 and 0 <= py < 360):\n                            okA = okB = False; break\n                        mA, mB = views[v][2][py][px], views[v][3][py][px]\n                        # Note: A can be occluded by B, B can be occluded by A!\n                        if not (mA or mB):\n                            okA = okB = False; break\n                        if not mA and not mB: pass\n                    if okA:\n                        # count how many views actually saw A vs B\n                        nA = sum(1 for v,(az,el) in cams.items() for px,py in [()] if False)\n                        cntA += 1\n                        ptsA.append((x,y,z))\n        print(f'sign={sign} fovy={fovy}: total visual hull voxels (A|B) = {cntA}')\n        if ptsA:\n            xs, ys, zs = zip(*ptsA)\n            print(f'  bbox: x=[{min(xs):.2f},{max(xs):.2f}] y=[{min(ys):.2f},{max(ys):.2f}] z=[{min(zs):.2f},{max(zs):.2f}] center=[{sum(xs)/len(xs):.3f},{sum(ys)/len(ys):.3f},{sum(zs)/len(zs):.3f}]')\n\"" action.permission=* action.action=allow action.pattern=*
