timestamp=2026-11-14T06:21:53.228Z level=INFO run=03a05625 message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/opencode/calib_fovy.py\nimport math\nfrom reconstruct import call_render, classify_image\n\nfor el in [5, 30, 60, 85]:\n    txt, im = call_render(azimuth=45, elevation=el, distance=5.0, lookat=[1.0, 0.5, 0.2])\n    w, h, g = classify_image(im)\n    n1 = sum(1 for v in g if v == 1)\n    n2 = sum(1 for v in g if v == 2)\n    print(f\"el={el}: txt={txt.split('|')[0]} grey={n1} blue={n2}\")\n\n# Calibrate f_px exactly using az=0, el=0, lookat=[1.2, 0.36, 0.28] at dist=3.5 and dist=5.0\n# Use shift in lookat.z by +0.4 at both distances!\nfor dist in [3.5, 5.0]:\n    _, im0 = call_render(azimuth=0, elevation=0, distance=dist, lookat=[1.2, 0.36, 0.28])\n    _, im1 = call_render(azimuth=0, elevation=0, distance=dist, lookat=[1.2, 0.36, 0.68])\n    w, h, g0 = classify_image(im0)\n    _, _, g1 = classify_image(im1)\n    # Find min y (topmost pixel) of blue tube_b\n    top0 = min(y for y in range(h) for x in range(w) if g0[y*w+x] == 2)\n    top1 = min(y for y in range(h) for x in range(w) if g1[y*w+x] == 2)\n    # Also centroid y of blue\n    cy0 = sum(y for y in range(h) for x in range(w) if g0[y*w+x] == 2) / sum(1 for v in g0 if v == 2)\n    cy1 = sum(y for y in range(h) for x in range(w) if g1[y*w+x] == 2) / sum(1 for v in g1 if v == 2)\n    print(f\"dist={dist}: top0={top0} top1={top1} dtop={top1-top0} cy0={cy0:.3f} cy1={cy1:.3f} dcy={cy1-cy0:.3f}\")\nEOF" action.permission=* action.action=allow action.pattern=*
