timestamp=2026-11-14T06:29:26.676Z level=INFO run=03a05625 message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/opencode/build_model.js\nconst fs = require('fs');\n\nconst meta = JSON.parse(fs.readFileSync('/tmp/opencode/views.json', 'utf8'));\nconst bin = fs.readFileSync('/tmp/opencode/views.bin');\nconst W = meta[0].w, H = meta[0].h, WH = W * H;\n\nfunction edt2d(maskFn) {\n  const out = new Float32Array(bin.length);\n  const INF = 1e6;\n  const N = Math.max(W, H);\n  const f = new Float32Array(N), d = new Float32Array(N), v = new Int32Array(N), z = new Float32Array(N + 1);\n  function edt1d(n) {\n    let k = 0; v[0] = 0; z[0] = -INF; z[1] = INF;\n    for (let q = 1; q < n; q++) {\n      let s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]);\n      while (s <= z[k]) { k--; s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]); }\n      k++; v[k] = q; z[k] = s; z[k + 1] = INF;\n    }\n    k = 0;\n    for (let q = 0; q < n; q++) {\n      while (z[k + 1] < q) k++;\n      const dx = q - v[k];\n      d[q] = dx * dx + f[v[k]];\n    }\n  }\n  for (let view = 0; view < meta.length; view++) {\n    const off = view * WH;\n    for (let y = 0; y < H; y++) {\n      for (let x = 0; x < W; x++) f[x] = maskFn(bin[off + y * W + x]) ? 0 : INF;\n      edt1d(W);\n      for (let x = 0; x < W; x++) out[off + y * W + x] = d[x];\n    }\n    for (let x = 0; x < W; x++) {\n      for (let y = 0; y < H; y++) f[y] = out[off + y * W + x];\n      edt1d(H);\n      for (let y = 0; y < H; y++) out[off + y * W + x] = Math.sqrt(d[y]);\n    }\n  }\n  return out;\n}\n\nconsole.time('edt2d');\nconst distAny = edt2d(c => c > 0);\nconsole.timeEnd('edt2d');\n\nconst fovy = 45.0;\nconst f_px = (H / 2) / Math.tan((fovy * Math.PI / 180) / 2);\nconst cams = meta.map((m, idx) => {\n  const az = m.az * Math.PI / 180, el = m.el * Math.PI / 180;\n  const fx = Math.cos(az) * Math.cos(el), fy = Math.sin(az) * Math.cos(el), fz = Math.sin(el);\n  const rh = Math.hypot(fx, fy);\n  const rx = fy / rh, ry = -fx / rh, rz = 0;\n  const ux = ry * fz - rz * fy, uy = rz * fx - rx * fz, uz = rx * fy - ry * fx;\n  return {\n    fx, fy, fz, rx, ry, rz, ux, uy, uz,\n    cx: m.lookat[0] - m.dist * fx,\n    cy: m.lookat[1] - m.dist * fy,\n    cz: m.lookat[2] - m.dist * fz,\n    f: f_px, offset: idx * WH\n  };\n});\n\nconsole.time('carve');\nconst RES = 0.01;\nconst cands = [];\nfunction recurse(cx, cy, cz, half) {\n  const r3d = half * 1.7320508;\n  let inViews = 0;\n  for (let i = 0; i < cams.length; i++) {\n    const c = cams[i];\n    const dx = cx - c.cx, dy = cy - c.cy, dz = cz - c.cz;\n    const depth = dx * c.fx + dy * c.fy + dz * c.fz;\n    if (depth <= 0.2) return;\n    const u = (W - 1) / 2 + c.f * (dx * c.rx + dy * c.ry + dz * c.rz) / depth;\n    const vp = (H - 1) / 2 - c.f * (dx * c.ux + dy * c.uy + dz * c.uz) / depth;\n    const ui = Math.round(u), vi = Math.round(vp);\n    if (ui < 0 || ui >= W || vi < 0 || vi >= H) continue;\n    inViews++;\n    const radPx = c.f * r3d / Math.max(0.2, depth - r3d) + 0.5;\n    if (distAny[c.offset + vi * W + ui] > radPx) return;\n  }\n  if (inViews < 25) return;\n  if (half <= RES / 2 + 1e-9) { cands.push({ x: cx, y: cy, z: cz, label: 0 }); return; }\n  const h2 = half / 2;\n  for (let sx = -1; sx <= 1; sx += 2)\n    for (let sy = -1; sy <= 1; sy += 2)\n      for (let sz = -1; sz <= 1; sz += 2)\n        recurse(cx + sx * h2, cy + sy * h2, cz + sz * h2, h2);\n}\nrecurse(1.0, 0.6, 0.2, 2.56);\nconsole.timeEnd('carve');\nconsole.log('Initial visual hull voxels:', cands.length);\n\n// Fast 2-pass z-buffer carving using 1x1 or 2x2 splat (10x faster!)\nconsole.time('zcarve');\nlet active = cands;\nfor (let iter = 0; iter < 3; iter++) {\n  const zbuf = new Float32Array(bin.length);\n  zbuf.fill(1e9);\n  for (let k = 0; k < active.length; k++) {\n    const v = active[k];\n    for (let i = 0; i < cams.length; i++) {\n      const c = cams[i];\n      const dx = v.x - c.cx, dy = v.y - c.cy, dz = v.z - c.cz;\n      const depth = dx * c.fx + dy * c.fy + dz * c.fz;\n      const u = Math.round((W - 1) / 2 + c.f * (dx * c.rx + dy * c.ry + dz * c.rz) / depth);\n      const vp = Math.round((H - 1) / 2 - c.f * (dx * c.ux + dy * c.uy + dz * c.uz) / depth);\n      if (u < 1 || u >= W - 1 || vp < 1 || vp >= H - 1) continue;\n      const base = c.offset + vp * W + u;\n      if (depth < zbuf[base]) zbuf[base] = depth;\n      if (depth < zbuf[base - 1]) zbuf[base - 1] = depth;\n      if (depth < zbuf[base + 1]) zbuf[base + 1] = depth;\n      if (depth < zbuf[base - W]) zbuf[base - W] = depth;\n      if (depth < zbuf[base + W]) zbuf[base + W] = depth;\n    }\n  }\n  const next = [];\n  for (let k = 0; k < active.length; k++) {\n    const v = active[k];\n    let vis1 = 0, vis2 = 0, visViews = 0;\n    for (let i = 0; i < cams.length; i++) {\n      const c = cams[i];\n      const dx = v.x - c.cx, dy = v.y - c.cy, dz = v.z - c.cz;\n      const depth = dx * c.fx + dy * c.fy + dz * c.fz;\n      const u = Math.round((W - 1) / 2 + c.f * (dx * c.rx + dy * c.ry + dz * c.rz) / depth);\n      const vp = Math.round((H - 1) / 2 - c.f * (dx * c.ux + dy * c.uy + dz * c.uz) / depth);\n      if (u < 1 || u >= W - 1 || vp < 1 || vp >= H - 1) continue;\n      if (depth <= zbuf[c.offset + vp * W + u] + 0.025) {\n        visViews++;\n        const cls = bin[c.offset + vp * W + u];\n        if (cls === 1) vis1++;\n        else if (cls === 2) vis2++;\n      }\n    }\n    if (visViews >= 4) {\n      if (vis1 >= vis2 && vis1 >= visViews * 0.75) { v.label = 1; next.push(v); }\n      else if (vis2 > vis1 && vis2 >= visViews * 0.75) { v.label = 2; next.push(v); }\n    } else {\n      next.push(v);\n    }\n  }\n  active = next;\n}\n// Assign any interior unlabeled voxels by nearest labeled neighbor\nconst voxA = active.filter(v => v.label === 1);\nconst voxB = active.filter(v => v.label === 2);\nconsole.timeEnd('zcarve');\nconsole.log(`voxA=${voxA.length}, voxB=${voxB.length}`);\n\n// Bounding boxes and PCA / moments of A and B\nfunction stats(vox) {\n  let minX=1e9,minY=1e9,minZ=1e9,maxX=-1e9,maxY=-1e9,maxZ=-1e9;\n  let sx=0,sy=0,sz=0;\n  for (const v of vox) {\n    if (v.x<minX) minX=v.x; if (v.x>maxX) maxX=v.x;\n    if (v.y<minY) minY=v.y; if (v.y>maxY) maxY=v.y;\n    if (v.z<minZ) minZ=v.z; if (v.z>maxZ) maxZ=v.z;\n    sx+=v.x; sy+=v.y; sz+=v.z;\n  }\n  const n = vox.length;\n  return { min:[minX,minY,minZ].map(x=>+x.toFixed(3)), max:[maxX,maxY,maxZ].map(x=>+x.toFixed(3)), mean:[+(sx/n).toFixed(4),+(sy/n).toFixed(4),+(sz/n).toFixed(4)] };\n}\nconsole.log('Stats A:', stats(voxA));\nconsole.log('Stats B:', stats(voxB));\n\n// Fast spatial grid min distance between A and B\nconst gridA = new Map();\nfor (const a of voxA) {\n  const key = `${Math.floor(a.x/0.1)},${Math.floor(a.y/0.1)},${Math.floor(a.z/0.1)}`;\n  let arr = gridA.get(key);\n  if (!arr) { arr = []; gridA.set(key, arr); }\n  arr.push(a);\n}\nlet minD = 1e9, closestPair = null;\nfor (const b of voxB) {\n  const gx = Math.floor(b.x/0.1), gy = Math.floor(b.y/0.1), gz = Math.floor(b.z/0.1);\n  for (let dx = -1; dx <= 1; dx++)\n    for (let dy = -1; dy <= 1; dy++)\n      for (let dz = -1; dz <= 1; dz++) {\n        const arr = gridA.get(`${gx+dx},${gy+dy},${gz+dz}`);\n        if (!arr) continue;\n        for (const a of arr) {\n          const d = Math.hypot(a.x - b.x, a.y - b.y, a.z - b.z);\n          if (d < minD) { minD = d; closestPair = [a, b]; }\n        }\n      }\n}\nconsole.log('Closest voxel center dist:', minD.toFixed(5), '(minus RES=0.01 -> surface dist ~', (minD - RES).toFixed(5), ', gt=0.04445)', closestPair);\n\nfs.writeFileSync('/tmp/opencode/voxAB.json', JSON.stringify({\n  voxA: voxA.map(v => [+v.x.toFixed(3), +v.y.toFixed(3), +v.z.toFixed(3)]),\n  voxB: voxB.map(v => [+v.x.toFixed(3), +v.y.toFixed(3), +v.z.toFixed(3)])\n}));\nEOF" action.permission=* action.action=allow action.pattern=*
