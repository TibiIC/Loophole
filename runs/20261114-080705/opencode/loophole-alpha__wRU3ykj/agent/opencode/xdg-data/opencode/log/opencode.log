timestamp=2026-11-14T06:23:40.035Z level=INFO run=03a05625 message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/opencode/carve.js\nconst fs = require('fs');\n\nconst meta = JSON.parse(fs.readFileSync('/tmp/opencode/views.json', 'utf8'));\nconst bin = fs.readFileSync('/tmp/opencode/views.bin');\nconst W = meta[0].w, H = meta[0].h, WH = W * H;\n\nfunction buildCameras(fovyDeg, azSign) {\n  const f = (H / 2) / Math.tan((fovyDeg * Math.PI / 180) / 2);\n  return meta.map((m, idx) => {\n    const az = azSign * m.az * Math.PI / 180;\n    const el = m.el * Math.PI / 180;\n    const fx = Math.cos(az) * Math.cos(el);\n    const fy = Math.sin(az) * Math.cos(el);\n    const fz = Math.sin(el);\n    // right = normalize(cross(f, [0,0,1])) = [fy, -fx, 0] / hypot(fx, fy)\n    const rh = Math.hypot(fx, fy);\n    const rx = fy / rh, ry = -fx / rh, rz = 0;\n    // up = cross(right, f)\n    const ux = ry * fz - rz * fy;\n    const uy = rz * fx - rx * fz;\n    const uz = rx * fy - ry * fx;\n    const cx = m.lookat[0] - m.dist * fx;\n    const cy = m.lookat[1] - m.dist * fy;\n    const cz = m.lookat[2] - m.dist * fz;\n    return { fx, fy, fz, rx, ry, rz, ux, uy, uz, cx, cy, cz, f, offset: idx * WH };\n  });\n}\n\n// Dilate foreground by 1px to tolerate subpixel/antialiasing when testing coarse voxels\nconst dilated = new Uint8Array(bin.length);\nfor (let v = 0; v < meta.length; v++) {\n  const off = v * WH;\n  for (let y = 0; y < H; y++) {\n    for (let x = 0; x < W; x++) {\n      let mask = 0;\n      for (let dy = -1; dy <= 1; dy++) {\n        const ny = y + dy;\n        if (ny < 0 || ny >= H) continue;\n        for (let dx = -1; dx <= 1; dx++) {\n          const nx = x + dx;\n          if (nx < 0 || nx >= W) continue;\n          const c = bin[off + ny * W + nx];\n          if (c === 1) mask |= 1;\n          else if (c === 2) mask |= 2;\n        }\n      }\n      dilated[off + y * W + x] = mask;\n    }\n  }\n}\n\nfor (const azSign of [1, -1]) {\n  for (const fovy of [30, 35, 40, 45, 50, 55, 60]) {\n    const cams = buildCameras(fovy, azSign);\n    let fgCount = 0;\n    for (let x = -0.6; x <= 3.0; x += 0.08) {\n      for (let y = -0.6; y <= 2.6; y += 0.08) {\n        for (let z = -0.8; z <= 1.6; z += 0.08) {\n          let misses = 0;\n          for (let i = 0; i < cams.length; i++) {\n            const c = cams[i];\n            const dx = x - c.cx, dy = y - c.cy, dz = z - c.cz;\n            const depth = dx * c.fx + dy * c.fy + dz * c.fz;\n            if (depth <= 0.1) { misses = 99; break; }\n            const u = Math.round((W - 1) / 2 + c.f * (dx * c.rx + dy * c.ry + dz * c.rz) / depth);\n            const vp = Math.round((H - 1) / 2 - c.f * (dx * c.ux + dy * c.uy + dz * c.uz) / depth);\n            if (u < 0 || u >= W || vp < 0 || vp >= H) continue;\n            if (dilated[c.offset + vp * W + u] === 0) {\n              if (++misses > 0) break;\n            }\n          }\n          if (misses === 0) fgCount++;\n        }\n      }\n    }\n    console.log(`azSign=${azSign} fovy=${fovy}: fgVoxels(8cm)=${fgCount}`);\n  }\n}\nEOF" action.permission=* action.action=allow action.pattern=*
