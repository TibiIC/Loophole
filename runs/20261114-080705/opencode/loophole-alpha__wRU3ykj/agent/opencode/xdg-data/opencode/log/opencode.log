timestamp=2026-11-14T06:21:18.677Z level=INFO run=03a05625 message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/opencode/reconstruct.py\nimport urllib.request, json, base64, math\nfrom inspect_scene import read_png\n\nurl = \"http://loophole-sim:8000/mcp\"\nheaders = {\"Content-Type\": \"application/json\", \"Accept\": \"application/json, text/event-stream\"}\n\ndef call_render(**kwargs):\n    req = urllib.request.Request(url, data=json.dumps({\n        \"jsonrpc\": \"2.0\", \"id\": 1, \"method\": \"tools/call\",\n        \"params\": {\"name\": \"render\", \"arguments\": kwargs}\n    }).encode(), headers=headers)\n    with urllib.request.urlopen(req) as resp:\n        data = json.loads(resp.read().decode())\n    for item in data[\"result\"][\"content\"]:\n        if item[\"type\"] == \"text\": txt = item[\"text\"]\n        elif item[\"type\"] == \"image\": img = base64.b64decode(item[\"data\"])\n    return txt, img\n\ndef classify_image(img_bytes):\n    # Write temp or parse directly from bytes\n    pos = 8\n    idat = bytearray()\n    import zlib, struct\n    while pos < len(img_bytes):\n        length, ctype = struct.unpack(\">I4s\", img_bytes[pos:pos+8])\n        chunk = img_bytes[pos+8:pos+8+length]\n        pos += 12 + length\n        if ctype == b\"IHDR\":\n            w, h, bd, ct, comp, filt, inter = struct.unpack(\">IIBBBBB\", chunk)\n        elif ctype == b\"IDAT\":\n            idat.extend(chunk)\n    raw = zlib.decompress(bytes(idat))\n    bpp = 3\n    stride = w * 3\n    prev = bytearray(stride)\n    # classes: 0 = bg, 1 = grey (tube_a), 2 = blue (tube_b)\n    grid = bytearray(w * h)\n    i = 0\n    for y in range(h):\n        f = raw[i]\n        row = bytearray(raw[i+1:i+1+stride])\n        i += 1 + stride\n        if f == 1:\n            for x in range(3, stride): row[x] = (row[x] + row[x-3]) & 0xff\n        elif f == 2:\n            for x in range(stride): row[x] = (row[x] + prev[x]) & 0xff\n        elif f == 3:\n            for x in range(stride):\n                a = row[x-3] if x >= 3 else 0\n                row[x] = (row[x] + ((a + prev[x]) >> 1)) & 0xff\n        elif f == 4:\n            for x in range(stride):\n                a = row[x-3] if x >= 3 else 0\n                b = prev[x]\n                c = prev[x-3] if x >= 3 else 0\n                p = a + b - c\n                pa, pb, pc = abs(p-a), abs(p-b), abs(p-c)\n                pr = a if (pa <= pb and pa <= pc) else (b if pb <= pc else c)\n                row[x] = (row[x] + pr) & 0xff\n        prev = row\n        # Background color on this scanline from leftmost/rightmost pixel\n        bg0 = (row[0], row[1], row[2])\n        bg1 = (row[-3], row[-2], row[-1])\n        base = y * w\n        for x in range(w):\n            r, g, b = row[x*3], row[x*3+1], row[x*3+2]\n            d0 = abs(r - bg0[0]) + abs(g - bg0[1]) + abs(b - bg0[2])\n            d1 = abs(r - bg1[0]) + abs(g - bg1[1]) + abs(b - bg1[2])\n            if min(d0, d1) <= 6:\n                grid[base + x] = 0\n            elif b - r >= 25:\n                grid[base + x] = 2\n            else:\n                grid[base + x] = 1\n    return w, h, grid\n\ndef blue_centroid(w, h, grid):\n    sx = sy = n = 0\n    for y in range(h):\n        base = y * w\n        for x in range(w):\n            if grid[base + x] == 2:\n                sx += x; sy += y; n += 1\n    return sx / n, sy / n, n\n\n# Step 1: Calibrate exact camera axes & fovy\nfor label, az, el, look0, look1 in [\n    (\"top_base\", 90, -90, [1.2, 0.5, 0.28], [1.7, 0.5, 0.28]),\n    (\"top_y\",    90, -90, [1.2, 0.5, 0.28], [1.2, 1.0, 0.28]),\n    (\"front_z\",  90,   0, [1.2, 0.36, 0.28], [1.2, 0.36, 0.78]),\n    (\"side_y\",    0,   0, [1.2, 0.36, 0.28], [1.2, 0.86, 0.28]),\n]:\n    t0, im0 = call_render(azimuth=az, elevation=el, distance=5.0, lookat=look0)\n    t1, im1 = call_render(azimuth=az, elevation=el, distance=5.0, lookat=look1)\n    w, h, g0 = classify_image(im0)\n    _, _, g1 = classify_image(im1)\n    c0 = blue_centroid(w, h, g0)\n    c1 = blue_centroid(w, h, g1)\n    print(f\"{label}: az={az} el={el} c0=({c0[0]:.2f},{c0[1]:.2f}) c1=({c1[0]:.2f},{c1[1]:.2f}) delta=({c1[0]-c0[0]:.2f}, {c1[1]-c0[1]:.2f})\")\nEOF" action.permission=* action.action=allow action.pattern=*
