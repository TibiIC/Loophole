timestamp=2026-11-14T06:42:04.974Z level=INFO run=03a05625 message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/opencode/measure_throat.js\nconst fs = require('fs');\nconst { R_A, t_A, pts5mm } = JSON.parse(fs.readFileSync('/tmp/opencode/pts5mm.json', 'utf8'));\n\n// Compute exact 3D interior EDT of pts5mm on its 5mm grid to get exact medial axis & tube radius!\nlet minI=[1e9,1e9,1e9], maxI=[-1e9,-1e9,-1e9];\nconst idxPts = pts5mm.map(p => [\n  Math.round((p[0] - 0.0025) / 0.005),\n  Math.round((p[1] - 0.0025) / 0.005),\n  Math.round((p[2] - 0.0025) / 0.005)\n]);\nfor (const q of idxPts) {\n  for (let d=0;d<3;d++) { if (q[d]<minI[d]) minI[d]=q[d]; if (q[d]>maxI[d]) maxI[d]=q[d]; }\n}\nconst NX = maxI[0]-minI[0]+5, NY = maxI[1]-minI[1]+5, NZ = maxI[2]-minI[2]+5;\nconsole.log(`5mm grid: ${NX}x${NY}x${NZ}`);\n\n// Distance to OUTSIDE (0 for empty cells, INF for interior cells)\nconst INF = 1e6;\nconst edtIn = new Float32Array(NX * NY * NZ); // 0 outside\nfor (const q of idxPts) {\n  const ix = q[0]-minI[0]+2, iy = q[1]-minI[1]+2, iz = q[2]-minI[2]+2;\n  edtIn[(iz*NY + iy)*NX + ix] = INF;\n}\n\n{\n  const maxN = Math.max(NX, NY, NZ);\n  const f = new Float32Array(maxN), d = new Float32Array(maxN), v = new Int32Array(maxN), z = new Float32Array(maxN + 1);\n  function edt1d(n) {\n    let k = 0; v[0] = 0; z[0] = -INF; z[1] = INF;\n    for (let q = 1; q < n; q++) {\n      let s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]);\n      while (s <= z[k]) { k--; s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]); }\n      k++; v[k] = q; z[k] = s; z[k + 1] = INF;\n    }\n    k = 0;\n    for (let q = 0; q < n; q++) {\n      while (z[k + 1] < q) k++;\n      const dx = q - v[k];\n      d[q] = dx * dx + f[v[k]];\n    }\n  }\n  for (let iz = 0; iz < NZ; iz++)\n    for (let iy = 0; iy < NY; iy++) {\n      const base = (iz*NY + iy)*NX;\n      for (let ix = 0; ix < NX; ix++) f[ix] = edtIn[base + ix];\n      edt1d(NX);\n      for (let ix = 0; ix < NX; ix++) edtIn[base + ix] = d[ix];\n    }\n  for (let iz = 0; iz < NZ; iz++)\n    for (let ix = 0; ix < NX; ix++) {\n      for (let iy = 0; iy < NY; iy++) f[iy] = edtIn[(iz*NY + iy)*NX + ix];\n      edt1d(NY);\n      for (let iy = 0; iy < NY; iy++) edtIn[(iz*NY + iy)*NX + ix] = d[iy];\n    }\n  for (let iy = 0; iy < NY; iy++)\n    for (let ix = 0; ix < NX; ix++) {\n      for (let iz = 0; iz < NZ; iz++) f[iz] = edtIn[(iz*NY + iy)*NX + ix];\n      edt1d(NZ);\n      for (let iz = 0; iz < NZ; iz++) edtIn[(iz*NY + iy)*NX + ix] = Math.sqrt(d[iz]) * 0.005;\n    }\n}\n\n// Find local maxima of edtIn (medial axis / centerline!)\nlet maxRad = 0;\nconst medial = [];\nfor (let iz = 2; iz < NZ-2; iz++)\n  for (let iy = 2; iy < NY-2; iy++)\n    for (let ix = 2; ix < NX-2; ix++) {\n      const val = edtIn[(iz*NY + iy)*NX + ix];\n      if (val <= 0.015) continue;\n      if (val > maxRad) maxRad = val;\n      // Check if >= at least 24 of 26 neighbors (ridge along 1D curve!)\n      let higher = 0;\n      for (let dz=-1;dz<=1;dz++)\n        for (let dy=-1;dy<=1;dy++)\n          for (let dx=-1;dx<=1;dx++) {\n            if (!dx && !dy && !dz) continue;\n            if (edtIn[((iz+dz)*NY + (iy+dy))*NX + (ix+dx)] > val + 1e-6) higher++;\n          }\n      if (higher <= 2) {\n        const x = (ix - 2 + minI[0]) * 0.005 + 0.0025;\n        const y = (iy - 2 + minI[1]) * 0.005 + 0.0025;\n        const z = (iz - 2 + minI[2]) * 0.005 + 0.0025;\n        medial.push({ x, y, z, r: val });\n      }\n    }\n\nconsole.log(`Max inscribed tube radius: ${maxRad.toFixed(5)}m (diameter ${(2*maxRad).toFixed(5)}m), medial ridge pts: ${medial.length}`);\n\n// Order medial points into a single ordered 1D curve from one tail tip to the other!\n// First cluster medial points at 2cm spacing\nmedial.sort((a, b) => b.r - a.r);\nconst nodes = [];\nfor (const m of medial) {\n  let close = false;\n  for (const n of nodes) {\n    if (Math.hypot(m.x-n.x, m.y-n.y, m.z-n.z) < 0.025) { close = true; break; }\n  }\n  if (!close) nodes.push(m);\n}\nconsole.log('Clustered centerline nodes (2.5cm spacing):', nodes.length);\n\n// Find an endpoint (node with only 1 neighbor within 7cm, largest X or Y)\nlet startIdx = 0, bestX = -1e9;\nfor (let i = 0; i < nodes.length; i++) {\n  if (nodes[i].x > bestX) { bestX = nodes[i].x; startIdx = i; }\n}\nconst ordered = [nodes[startIdx]];\nconst used = new Uint8Array(nodes.length);\nused[startIdx] = 1;\nwhile (ordered.length < nodes.length) {\n  const cur = ordered[ordered.length - 1];\n  let best = -1, bestD = 1e9;\n  for (let i = 0; i < nodes.length; i++) {\n    if (used[i]) continue;\n    const d = Math.hypot(cur.x-nodes[i].x, cur.y-nodes[i].y, cur.z-nodes[i].z);\n    if (d < bestD) { bestD = d; best = i; }\n  }\n  if (best === -1 || bestD > 0.12) break;\n  used[best] = 1;\n  ordered.push(nodes[best]);\n}\nconsole.log(`Ordered curve nodes: ${ordered.length}/${nodes.length}`);\nconst radii = ordered.map(n => n.r).sort((a,b) => a-b);\nconsole.log(`Radius stats along curve: p10=${radii[Math.floor(radii.length*0.1)].toFixed(4)} median=${radii[Math.floor(radii.length*0.5)].toFixed(4)} p90=${radii[Math.floor(radii.length*0.9)].toFixed(4)}`);\n\n// Find the THROAT (closest approach between two non-adjacent segments of the curve, |i - j| > 15)!\nlet minThroat = 1e9, throatPair = null;\nfor (let i = 0; i < ordered.length; i++) {\n  for (let j = i + 20; j < ordered.length; j++) {\n    const d = Math.hypot(ordered[i].x-ordered[j].x, ordered[i].y-ordered[j].y, ordered[i].z-ordered[j].z);\n    if (d < minThroat) { minThroat = d; throatPair = [i, j, ordered[i], ordered[j]]; }\n  }\n}\nconst [ti, tj, p1, p2] = throatPair;\nconsole.log(`THROAT center-to-center dist = ${minThroat.toFixed(5)}m between idx ${ti} (${p1.x.toFixed(3)},${p1.y.toFixed(3)},${p1.z.toFixed(3)} r=${p1.r.toFixed(4)}) and idx ${tj} (${p2.x.toFixed(3)},${p2.y.toFixed(3)},${p2.z.toFixed(3)} r=${p2.r.toFixed(4)})`);\nconsole.log(`THROAT surface-to-surface opening = ${(minThroat - p1.r - p2.r).toFixed(5)}m vs tube diameter = ${(2 * radii[Math.floor(radii.length*0.5)]).toFixed(5)}m!!`);\nconsole.log(`=> EXCESS CLEARANCE FOR PASSING STRAND THROUGH THROAT = ${(minThroat - p1.r - p2.r - 2 * radii[Math.floor(radii.length*0.5)]).toFixed(5)}m!!`);\n\n// Print every 5th node along ordered curve\nfor (let i = 0; i < ordered.length; i += 5) {\n  const n = ordered[i];\n  console.log(`  [${String(i).padStart(3)}] (${n.x.toFixed(3)}, ${n.y.toFixed(3)}, ${n.z.toFixed(3)}) r=${n.r.toFixed(4)}`);\n}\n\nfs.writeFileSync('/tmp/opencode/centerline.json', JSON.stringify({ R_A, t_A, ordered }));\nEOF" action.permission=* action.action=allow action.pattern=*
