timestamp=2026-11-14T06:33:37.290Z level=INFO run=03a05625 message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/opencode/build_sdf_and_plan.js\nconst fs = require('fs');\nconst { R_A, t_A, pts5mm } = JSON.parse(fs.readFileSync('/tmp/opencode/pts5mm.json', 'utf8'));\n\nconsole.log('Loaded pts5mm:', pts5mm.length);\n\n// 1. Extract surface points of pts5mm (5mm grid)\nconst set5 = new Set();\nfor (const p of pts5mm) {\n  set5.add(`${Math.round(p[0]*200)},${Math.round(p[1]*200)},${Math.round(p[2]*200)}`);\n}\nconst surfLocal = [];\nfor (const p of pts5mm) {\n  const ix = Math.round(p[0]*200), iy = Math.round(p[1]*200), iz = Math.round(p[2]*200);\n  if (!set5.has(`${ix+1},${iy},${iz}`) || !set5.has(`${ix-1},${iy},${iz}`) ||\n      !set5.has(`${ix},${iy+1},${iz}`) || !set5.has(`${ix},${iy-1},${iz}`) ||\n      !set5.has(`${ix},${iy},${iz+1}`) || !set5.has(`${ix},${iy},${iz-1}`)) {\n    surfLocal.push(p);\n  }\n}\nconsole.log('Surface 5mm points:', surfLocal.length);\n\n// Farthest/grid-subsampled surface points of tube_b at 1.0cm (coarse, ~1500 pts) and 0.5cm (fine, ~6000 pts)\nfunction subsampleGrid(pts, cell) {\n  const map = new Map();\n  for (const p of pts) {\n    const k = `${Math.floor(p[0]/cell)},${Math.floor(p[1]/cell)},${Math.floor(p[2]/cell)}`;\n    if (!map.has(k)) map.set(k, p);\n  }\n  return Array.from(map.values());\n}\nconst coarseB = subsampleGrid(surfLocal, 0.035);\nconst medB    = subsampleGrid(surfLocal, 0.015);\nconst fineB   = subsampleGrid(surfLocal, 0.0075);\nconsole.log(`Subsampled B surface: coarse=${coarseB.length}, med=${medB.length}, fine=${fineB.length}`);\n\n// Flatten into Float64Arrays for ultra-fast V8 loops\nfunction flattenPts(pts) {\n  const arr = new Float64Array(pts.length * 3);\n  for (let i = 0; i < pts.length; i++) {\n    arr[i*3] = pts[i][0]; arr[i*3+1] = pts[i][1]; arr[i*3+2] = pts[i][2];\n  }\n  return arr;\n}\nconst coarseBArr = flattenPts(coarseB);\nconst medBArr    = flattenPts(medB);\nconst fineBArr   = flattenPts(fineB);\n\n// 2. Build 3D EDT of tube_a on [-0.65, 2.95] x [-0.70, 2.18] x [-0.75, 1.01] at h = 0.008m (8mm)!\nconst H_GRID = 0.008;\nconst OX = -0.65, OY = -0.70, OZ = -0.75;\nconst NX = 450, NY = 360, NZ = 220; // 35.64M cells = 142 MB\nconsole.time('edt3d');\nconst sdfA = new Float32Array(NX * NY * NZ);\nconst INF = 1e6;\nsdfA.fill(INF);\n\n// Mark all pts5mm transformed by (R_A, t_A)\nfor (const b of pts5mm) {\n  const ax = R_A[0][0]*b[0] + R_A[0][1]*b[1] + R_A[0][2]*b[2] + t_A[0];\n  const ay = R_A[1][0]*b[0] + R_A[1][1]*b[1] + R_A[1][2]*b[2] + t_A[1];\n  const az = R_A[2][0]*b[0] + R_A[2][1]*b[1] + R_A[2][2]*b[2] + t_A[2];\n  const ix = Math.round((ax - OX) / H_GRID);\n  const iy = Math.round((ay - OY) / H_GRID);\n  const iz = Math.round((az - OZ) / H_GRID);\n  if (ix >= 0 && ix < NX && iy >= 0 && iy < NY && iz >= 0 && iz < NZ) {\n    sdfA[(iz * NY + iy) * NX + ix] = 0;\n  }\n}\n\n// Exact 3D separable Felzenszwalb-Huttenlocher EDT\n{\n  const maxN = Math.max(NX, NY, NZ);\n  const f = new Float32Array(maxN), d = new Float32Array(maxN), v = new Int32Array(maxN), z = new Float32Array(maxN + 1);\n  function edt1d(n) {\n    let k = 0; v[0] = 0; z[0] = -INF; z[1] = INF;\n    for (let q = 1; q < n; q++) {\n      let s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]);\n      while (s <= z[k]) { k--; s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]); }\n      k++; v[k] = q; z[k] = s; z[k + 1] = INF;\n    }\n    k = 0;\n    for (let q = 0; q < n; q++) {\n      while (z[k + 1] < q) k++;\n      const dx = q - v[k];\n      d[q] = dx * dx + f[v[k]];\n    }\n  }\n  // X pass\n  for (let iz = 0; iz < NZ; iz++) {\n    for (let iy = 0; iy < NY; iy++) {\n      const base = (iz * NY + iy) * NX;\n      for (let ix = 0; ix < NX; ix++) f[ix] = sdfA[base + ix];\n      edt1d(NX);\n      for (let ix = 0; ix < NX; ix++) sdfA[base + ix] = d[ix];\n    }\n  }\n  // Y pass\n  for (let iz = 0; iz < NZ; iz++) {\n    for (let ix = 0; ix < NX; ix++) {\n      for (let iy = 0; iy < NY; iy++) f[iy] = sdfA[(iz * NY + iy) * NX + ix];\n      edt1d(NY);\n      for (let iy = 0; iy < NY; iy++) sdfA[(iz * NY + iy) * NX + ix] = d[iy];\n    }\n  }\n  // Z pass + sqrt * H_GRID\n  for (let iy = 0; iy < NY; iy++) {\n    for (let ix = 0; ix < NX; ix++) {\n      for (let iz = 0; iz < NZ; iz++) f[iz] = sdfA[(iz * NY + iy) * NX + ix];\n      edt1d(NZ);\n      for (let iz = 0; iz < NZ; iz++) sdfA[(iz * NY + iy) * NX + ix] = Math.sqrt(d[iz]) * H_GRID;\n    }\n  }\n}\nconsole.timeEnd('edt3d');\n\n// Query SDF at world point (wx, wy, wz) with trilinear interpolation\nconst INV_H = 1.0 / H_GRID;\nfunction querySDF(wx, wy, wz) {\n  let gx = (wx - OX) * INV_H;\n  let gy = (wy - OY) * INV_H;\n  let gz = (wz - OZ) * INV_H;\n  let outDist2 = 0;\n  if (gx < 0) { outDist2 += (gx * H_GRID) ** 2; gx = 0; }\n  else if (gx > NX - 1.001) { outDist2 += ((gx - (NX - 1)) * H_GRID) ** 2; gx = NX - 1.001; }\n  if (gy < 0) { outDist2 += (gy * H_GRID) ** 2; gy = 0; }\n  else if (gy > NY - 1.001) { outDist2 += ((gy - (NY - 1)) * H_GRID) ** 2; gy = NY - 1.001; }\n  if (gz < 0) { outDist2 += (gz * H_GRID) ** 2; gz = 0; }\n  else if (gz > NZ - 1.001) { outDist2 += ((gz - (NZ - 1)) * H_GRID) ** 2; gz = NZ - 1.001; }\n\n  const ix = gx | 0, iy = gy | 0, iz = gz | 0;\n  const fx = gx - ix, fy = gy - iy, fz = gz - iz;\n  const base = (iz * NY + iy) * NX + ix;\n  const strideZ = NY * NX;\n  const c000 = sdfA[base], c100 = sdfA[base + 1];\n  const c010 = sdfA[base + NX], c110 = sdfA[base + NX + 1];\n  const c001 = sdfA[base + strideZ], c101 = sdfA[base + strideZ + 1];\n  const c011 = sdfA[base + strideZ + NX], c111 = sdfA[base + strideZ + NX + 1];\n  const c00 = c000 + fx * (c100 - c000), c10 = c010 + fx * (c110 - c010);\n  const c01 = c001 + fx * (c101 - c001), c11 = c011 + fx * (c111 - c011);\n  const c0 = c00 + fy * (c10 - c00), c1 = c01 + fy * (c11 - c01);\n  const dGrid = c0 + fz * (c1 - c0);\n  return outDist2 > 0 ? Math.hypot(dGrid, Math.sqrt(outDist2)) : dGrid;\n}\n\nfunction minClearance(pos, quat, margin = 0.008) {\n  const [px, py, pz] = pos;\n  const [w, x, y, z] = quat;\n  const r00 = 1 - 2*(y*y + z*z), r01 = 2*(x*y - w*z), r02 = 2*(x*z + w*y);\n  const r10 = 2*(x*y + w*z), r11 = 1 - 2*(x*x + z*z), r12 = 2*(y*z - w*x);\n  const r20 = 2*(x*z - w*y), r21 = 2*(y*z + w*x), r22 = 1 - 2*(x*x + y*y);\n\n  // Stage 1: coarseB (~250 pts, spacing 3.5cm -> max surface-to-sample offset ~2.0cm)\n  let minC = 1e9;\n  for (let i = 0; i < coarseBArr.length; i += 3) {\n    const bx = coarseBArr[i], by = coarseBArr[i+1], bz = coarseBArr[i+2];\n    const d = querySDF(\n      px + r00*bx + r01*by + r02*bz,\n      py + r10*bx + r11*by + r12*bz,\n      pz + r20*bx + r21*by + r22*bz\n    );\n    if (d < margin - 0.002) return d; // Definitely colliding!\n    if (d < minC) minC = d;\n  }\n  if (minC > margin + 0.030 && minC < 0.38) return minC; // Safely clear!\n\n  // Stage 2: medB (~1500 pts, spacing 1.5cm -> offset ~0.8cm)\n  let minM = 1e9;\n  for (let i = 0; i < medBArr.length; i += 3) {\n    const bx = medBArr[i], by = medBArr[i+1], bz = medBArr[i+2];\n    const d = querySDF(\n      px + r00*bx + r01*by + r02*bz,\n      py + r10*bx + r11*by + r12*bz,\n      pz + r20*bx + r21*by + r22*bz\n    );\n    if (d < margin) return d;\n    if (d < minM) minM = d;\n  }\n  if (minM > margin + 0.012 && minM < 0.39) return minM;\n\n  // Stage 3: fineB (~6000 pts, spacing 7.5mm)\n  let minF = 1e9;\n  for (let i = 0; i < fineBArr.length; i += 3) {\n    const bx = fineBArr[i], by = fineBArr[i+1], bz = fineBArr[i+2];\n    const d = querySDF(\n      px + r00*bx + r01*by + r02*bz,\n      py + r10*bx + r11*by + r12*bz,\n      pz + r20*bx + r21*by + r22*bz\n    );\n    if (d < margin) return d;\n    if (d < minF) minF = d;\n  }\n  return minF;\n}\n\nconsole.log('Initial minClearance([1.2,0.36,0.28], [1,0,0,0]):', minClearance([1.2, 0.36, 0.28], [1, 0, 0, 0], 0.0).toFixed(5), '(gt=0.04445)');\n\n// Benchmark speed!\nconsole.time('100k_queries');\nlet validCount = 0;\nfor (let i = 0; i < 100000; i++) {\n  const pos = [Math.random()*2.5, Math.random()*2.0, Math.random()*1.5 - 0.5];\n  let u1 = Math.random(), u2 = Math.random()*2*Math.PI, u3 = Math.random()*2*Math.PI;\n  const s1 = Math.sqrt(1-u1), s2 = Math.sqrt(u1);\n  const quat = [s1*Math.sin(u2), s1*Math.cos(u2), s2*Math.sin(u3), s2*Math.cos(u3)];\n  if (minClearance(pos, quat, 0.010) >= 0.010) validCount++;\n}\nconsole.timeEnd('100k_queries');\nconsole.log('Random valid configs / 100k:', validCount);\nEOF" action.permission=* action.action=allow action.pattern=*
