timestamp=2026-11-14T06:38:21.223Z level=INFO run=03a05625 message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/opencode/solve_alpha.js\nconst fs = require('fs');\nconst { R_A, t_A, pts5mm } = JSON.parse(fs.readFileSync('/tmp/opencode/pts5mm.json', 'utf8'));\n\n// 1. Proper integer grid indexing for 5mm points (which sit at 0.0025 + 0.005 * k)\nconst toIdx = v => Math.round((v - 0.0025) / 0.005);\nconst set5 = new Set();\nfor (const p of pts5mm) {\n  set5.add(`${toIdx(p[0])},${toIdx(p[1])},${toIdx(p[2])}`);\n}\nconst surfLocal = [];\nfor (const p of pts5mm) {\n  const ix = toIdx(p[0]), iy = toIdx(p[1]), iz = toIdx(p[2]);\n  if (!set5.has(`${ix+1},${iy},${iz}`) || !set5.has(`${ix-1},${iy},${iz}`) ||\n      !set5.has(`${ix},${iy+1},${iz}`) || !set5.has(`${ix},${iy-1},${iz}`) ||\n      !set5.has(`${ix},${iy},${iz+1}`) || !set5.has(`${ix},${iy},${iz-1}`)) {\n    surfLocal.push(p);\n  }\n}\nconsole.log(`pts5mm=${pts5mm.length}, true surfLocal=${surfLocal.length}`);\n\n// Farthest-point sampling on surfLocal for optimal uniform coverage!\nfunction farthestPointSample(pts, count) {\n  const n = pts.length;\n  const chosen = [pts[0]];\n  const minDist2 = new Float64Array(n).fill(1e9);\n  for (let k = 1; k < count; k++) {\n    const last = chosen[k - 1];\n    let bestIdx = 0, bestD2 = -1;\n    for (let i = 0; i < n; i++) {\n      const p = pts[i];\n      const d2 = (p[0]-last[0])**2 + (p[1]-last[1])**2 + (p[2]-last[2])**2;\n      if (d2 < minDist2[i]) minDist2[i] = d2;\n      if (minDist2[i] > bestD2) { bestD2 = minDist2[i]; bestIdx = i; }\n    }\n    chosen.push(pts[bestIdx]);\n    if (k === count - 1) console.log(`FPS(${count}) covering radius = ${Math.sqrt(bestD2).toFixed(4)}m`);\n  }\n  const flat = new Float64Array(count * 3);\n  for (let i = 0; i < count; i++) {\n    flat[i*3] = chosen[i][0]; flat[i*3+1] = chosen[i][1]; flat[i*3+2] = chosen[i][2];\n  }\n  return flat;\n}\n\nconsole.time('fps');\nconst tier0 = farthestPointSample(surfLocal, 80);    // ~9cm spacing -> fast broadphase\nconst tier1 = farthestPointSample(surfLocal, 450);   // ~3cm spacing -> medium check\nconst tier2 = farthestPointSample(surfLocal, 2500);  // ~1.1cm spacing -> fine check (<1.5mm surface error!)\nconsole.timeEnd('fps');\n\n// 2. Build 6mm 3D EDT of tube_a covering [-0.55, 2.85] x [-0.60, 2.04] x [-0.65, 0.91]\nconst H_GRID = 0.006;\nconst OX = -0.55, OY = -0.60, OZ = -0.65;\nconst NX = 568, NY = 440, NZ = 260; // 64.9M floats = 259 MB\nconsole.time('edt3d');\nconst sdfA = new Float32Array(NX * NY * NZ);\nconst INF = 1e6;\nsdfA.fill(INF);\n\n// Only need surfLocal transformed by (R_A, t_A) + interior pts5mm to mark tube_a=0!\nfor (const b of pts5mm) {\n  const ax = R_A[0][0]*b[0] + R_A[0][1]*b[1] + R_A[0][2]*b[2] + t_A[0];\n  const ay = R_A[1][0]*b[0] + R_A[1][1]*b[1] + R_A[1][2]*b[2] + t_A[1];\n  const az = R_A[2][0]*b[0] + R_A[2][1]*b[1] + R_A[2][2]*b[2] + t_A[2];\n  const ix = Math.round((ax - OX) / H_GRID);\n  const iy = Math.round((ay - OY) / H_GRID);\n  const iz = Math.round((az - OZ) / H_GRID);\n  if (ix >= 0 && ix < NX && iy >= 0 && iy < NY && iz >= 0 && iz < NZ) {\n    sdfA[(iz * NY + iy) * NX + ix] = 0;\n  }\n}\n\n{\n  const maxN = Math.max(NX, NY, NZ);\n  const f = new Float32Array(maxN), d = new Float32Array(maxN), v = new Int32Array(maxN), z = new Float32Array(maxN + 1);\n  function edt1d(n) {\n    let k = 0; v[0] = 0; z[0] = -INF; z[1] = INF;\n    for (let q = 1; q < n; q++) {\n      let s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]);\n      while (s <= z[k]) { k--; s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]); }\n      k++; v[k] = q; z[k] = s; z[k + 1] = INF;\n    }\n    k = 0;\n    for (let q = 0; q < n; q++) {\n      while (z[k + 1] < q) k++;\n      const dx = q - v[k];\n      d[q] = dx * dx + f[v[k]];\n    }\n  }\n  for (let iz = 0; iz < NZ; iz++) {\n    for (let iy = 0; iy < NY; iy++) {\n      const base = (iz * NY + iy) * NX;\n      for (let ix = 0; ix < NX; ix++) f[ix] = sdfA[base + ix];\n      edt1d(NX);\n      for (let ix = 0; ix < NX; ix++) sdfA[base + ix] = d[ix];\n    }\n  }\n  for (let iz = 0; iz < NZ; iz++) {\n    for (let ix = 0; ix < NX; ix++) {\n      for (let iy = 0; iy < NY; iy++) f[iy] = sdfA[(iz * NY + iy) * NX + ix];\n      edt1d(NY);\n      for (let iy = 0; iy < NY; iy++) sdfA[(iz * NY + iy) * NX + ix] = d[iy];\n    }\n  }\n  for (let iy = 0; iy < NY; iy++) {\n    for (let ix = 0; ix < NX; ix++) {\n      for (let iz = 0; iz < NZ; iz++) f[iz] = sdfA[(iz * NY + iy) * NX + ix];\n      edt1d(NZ);\n      for (let iz = 0; iz < NZ; iz++) sdfA[(iz * NY + iy) * NX + ix] = Math.sqrt(d[iz]) * H_GRID;\n    }\n  }\n}\nconsole.timeEnd('edt3d');\n\nconst INV_H = 1.0 / H_GRID;\nconst STRIDE_Z = NY * NX;\n\nfunction querySDF(wx, wy, wz) {\n  let gx = (wx - OX) * INV_H;\n  let gy = (wy - OY) * INV_H;\n  let gz = (wz - OZ) * INV_H;\n  let out2 = 0;\n  if (gx < 0) { out2 += (gx * H_GRID) ** 2; gx = 0; }\n  else if (gx >= NX - 1) { out2 += ((gx - (NX - 1.001)) * H_GRID) ** 2; gx = NX - 1.001; }\n  if (gy < 0) { out2 += (gy * H_GRID) ** 2; gy = 0; }\n  else if (gy >= NY - 1) { out2 += ((gy - (NY - 1.001)) * H_GRID) ** 2; gy = NY - 1.001; }\n  if (gz < 0) { out2 += (gz * H_GRID) ** 2; gz = 0; }\n  else if (gz >= NZ - 1) { out2 += ((gz - (NZ - 1.001)) * H_GRID) ** 2; gz = NZ - 1.001; }\n  const ix = gx | 0, iy = gy | 0, iz = gz | 0;\n  const fx = gx - ix, fy = gy - iy, fz = gz - iz;\n  const base = iz * STRIDE_Z + iy * NX + ix;\n  const c00 = sdfA[base] + fx * (sdfA[base + 1] - sdfA[base]);\n  const c10 = sdfA[base + NX] + fx * (sdfA[base + NX + 1] - sdfA[base + NX]);\n  const c01 = sdfA[base + STRIDE_Z] + fx * (sdfA[base + STRIDE_Z + 1] - sdfA[base + STRIDE_Z]);\n  const c11 = sdfA[base + STRIDE_Z + NX] + fx * (sdfA[base + STRIDE_Z + NX + 1] - sdfA[base + STRIDE_Z + NX]);\n  const dGrid = (c00 + fy * (c10 - c00)) + fz * ((c01 + fy * (c11 - c01)) - (c00 + fy * (c10 - c00)));\n  return out2 > 0 ? Math.hypot(dGrid, Math.sqrt(out2)) : dGrid;\n}\n\nfunction minClearance(pos, quat, margin = 0.008) {\n  const px = pos[0], py = pos[1], pz = pos[2];\n  // Workspace check\n  if (px < -0.75 || px > 3.15 || py < -0.75 || py > 3.15 || pz < -0.75 || pz > 3.15) return -1;\n  const w = quat[0], x = quat[1], y = quat[2], z = quat[3];\n  const r00 = 1 - 2*(y*y + z*z), r01 = 2*(x*y - w*z), r02 = 2*(x*z + w*y);\n  const r10 = 2*(x*y + w*z), r11 = 1 - 2*(x*x + z*z), r12 = 2*(y*z - w*x);\n  const r20 = 2*(x*z - w*y), r21 = 2*(y*z + w*x), r22 = 1 - 2*(x*x + y*y);\n\n  let m0 = 1e9;\n  for (let i = 0; i < tier0.length; i += 3) {\n    const bx = tier0[i], by = tier0[i+1], bz = tier0[i+2];\n    const d = querySDF(px + r00*bx + r01*by + r02*bz, py + r10*bx + r11*by + r12*bz, pz + r20*bx + r21*by + r22*bz);\n    if (d < margin) return d;\n    if (d < m0) m0 = d;\n  }\n  if (m0 > margin + 0.075 && m0 < 0.35) return m0;\n\n  let m1 = 1e9;\n  for (let i = 0; i < tier1.length; i += 3) {\n    const bx = tier1[i], by = tier1[i+1], bz = tier1[i+2];\n    const d = querySDF(px + r00*bx + r01*by + r02*bz, py + r10*bx + r11*by + r12*bz, pz + r20*bx + r21*by + r22*bz);\n    if (d < margin) return d;\n    if (d < m1) m1 = d;\n  }\n  if (m1 > margin + 0.025 && m1 < 0.38) return m1;\n\n  let m2 = 1e9;\n  for (let i = 0; i < tier2.length; i += 3) {\n    const bx = tier2[i], by = tier2[i+1], bz = tier2[i+2];\n    const d = querySDF(px + r00*bx + r01*by + r02*bz, py + r10*bx + r11*by + r12*bz, pz + r20*bx + r21*by + r22*bz);\n    if (d < margin) return d;\n    if (d < m2) m2 = d;\n  }\n  return m2;\n}\n\nconsole.log('Initial clearance:', minClearance([1.2, 0.36, 0.28], [1, 0, 0, 0], 0).toFixed(5), '(gt=0.04445)');\nconsole.time('100k_fast');\nlet ok = 0;\nfor (let i = 0; i < 100000; i++) {\n  const pos = [Math.random()*2.5, Math.random()*2.0, Math.random()*1.5 - 0.5];\n  const u1 = Math.random(), u2 = Math.random()*6.283185, u3 = Math.random()*6.283185;\n  const s1 = Math.sqrt(1-u1), s2 = Math.sqrt(u1);\n  if (minClearance(pos, [s1*Math.sin(u2), s1*Math.cos(u2), s2*Math.sin(u3), s2*Math.cos(u3)], 0.010) >= 0.010) ok++;\n}\nconsole.timeEnd('100k_fast');\nconsole.log('ok:', ok);\n\n// 3. 6-DOF Clearance-Ascent Repulsion (pushes a config toward higher clearance in narrow passages!)\nfunction repel6DOF(pos, quat, targetClear = 0.020, iters = 4) {\n  let p = pos.slice(), q = quat.slice();\n  const eps = 0.006;\n  for (let it = 0; it < iters; it++) {\n    const w = q[0], x = q[1], y = q[2], z = q[3];\n    const r00 = 1 - 2*(y*y + z*z), r01 = 2*(x*y - w*z), r02 = 2*(x*z + w*y);\n    const r10 = 2*(x*y + w*z), r11 = 1 - 2*(x*x + z*z), r12 = 2*(y*z - w*x);\n    const r20 = 2*(x*z - w*y), r21 = 2*(y*z + w*x), r22 = 1 - 2*(x*x + y*y);\n    let fx = 0, fy = 0, fz = 0, tx = 0, ty = 0, tz = 0, wSum = 0, minD = 1e9;\n    for (let i = 0; i < tier1.length; i += 3) {\n      const bx = tier1[i], by = tier1[i+1], bz = tier1[i+2];\n      const rx = r00*bx + r01*by + r02*bz;\n      const ry = r10*bx + r11*by + r12*bz;\n      const rz = r20*bx + r21*by + r22*bz;\n      const wx = p[0] + rx, wy = p[1] + ry, wz = p[2] + rz;\n      const d = querySDF(wx, wy, wz);\n      if (d < minD) minD = d;\n      if (d < targetClear + 0.025) {\n        const gx = (querySDF(wx + eps, wy, wz) - querySDF(wx - eps, wy, wz)) / (2 * eps);\n        const gy = (querySDF(wx, wy + eps, wz) - querySDF(wx, wy - eps, wz)) / (2 * eps);\n        const gz = (querySDF(wx, wy, wz + eps) - querySDF(wx, wy, wz - eps)) / (2 * eps);\n        const wt = Math.exp((targetClear - d) * 80);\n        fx += wt * gx; fy += wt * gy; fz += wt * gz;\n        tx += wt * (ry * gz - rz * gy);\n        ty += wt * (rz * gx - rx * gz);\n        tz += wt * (rx * gy - ry * gx);\n        wSum += wt;\n      }\n    }\n    if (minD >= targetClear || wSum < 1e-9) break;\n    fx /= wSum; fy /= wSum; fz /= wSum;\n    tx /= wSum; ty /= wSum; tz /= wSum;\n    const fn = Math.hypot(fx, fy, fz), tn = Math.hypot(tx, ty, tz);\n    const stepP = Math.min(0.012, Math.max(0.003, targetClear - minD));\n    if (fn > 1e-6) { p[0] += stepP * fx / fn; p[1] += stepP * fy / fn; p[2] += stepP * fz / fn; }\n    if (tn > 1e-6) {\n      const ang = Math.min(0.020, stepP * 0.8) * 0.5;\n      const ax = tx / tn * ang, ay = ty / tn * ang, az = tz / tn * ang;\n      // q_new = [1, ax, ay, az] * q\n      const nw = w - ax*x - ay*y - az*z;\n      const nx = ax*w + x + ay*z - az*y;\n      const ny = ay*w - ax*z + y + az*x;\n      const nz = az*w + ax*y - ay*x + z;\n      const qn = Math.hypot(nw, nx, ny, nz);\n      q = [nw/qn, nx/qn, ny/qn, nz/qn];\n    }\n  }\n  return { pos: p, quat: q };\n}\n\n// Quaternion helpers\nfunction quatDist(a, b) {\n  const dot = Math.abs(a[0]*b[0] + a[1]*b[1] + a[2]*b[2] + a[3]*b[3]);\n  return 2 * Math.acos(Math.min(1, dot));\n}\nfunction slerp(a, b, t) {\n  let bx = b[0], by = b[1], bz = b[2], bw = b[3];\n  // Wait: our quat order is [w, x, y, z]!\n  let dot = a[0]*b[0] + a[1]*b[1] + a[2]*b[2] + a[3]*b[3];\n  let sgn = 1;\n  if (dot < 0) { dot = -dot; sgn = -1; }\n  let s0, s1;\n  if (dot > 0.9995) { s0 = 1 - t; s1 = t * sgn; }\n  else {\n    const th = Math.acos(Math.min(1, dot)), sinTh = Math.sin(th);\n    s0 = Math.sin((1 - t) * th) / sinTh;\n    s1 = Math.sin(t * th) / sinTh * sgn;\n  }\n  const w = s0*a[0] + s1*b[0], x = s0*a[1] + s1*b[1], y = s0*a[2] + s1*b[2], z = s0*a[3] + s1*b[3];\n  const n = Math.hypot(w, x, y, z);\n  return [w/n, x/n, y/n, z/n];\n}\nfunction cfgDist(a, b) {\n  return Math.hypot(a.pos[0]-b.pos[0], a.pos[1]-b.pos[1], a.pos[2]-b.pos[2]) + 0.8 * quatDist(a.quat, b.quat);\n}\n\nfunction edgeValid(a, b, margin) {\n  const dp = Math.hypot(a.pos[0]-b.pos[0], a.pos[1]-b.pos[1], a.pos[2]-b.pos[2]);\n  const dq = quatDist(a.quat, b.quat);\n  const steps = Math.max(2, Math.ceil(Math.max(dp / 0.015, dq / 0.025)));\n  for (let i = 1; i <= steps; i++) {\n    const t = i / steps;\n    const p = [a.pos[0]+t*(b.pos[0]-a.pos[0]), a.pos[1]+t*(b.pos[1]-a.pos[1]), a.pos[2]+t*(b.pos[2]-a.pos[2])];\n    const q = slerp(a.quat, b.quat, t);\n    if (minClearance(p, q, margin) < margin) return false;\n  }\n  return true;\n}\n\n// 4. Bi-directional RRT-Connect with Clearance-Sliding!\nfunction solveRRT(margin = 0.010, maxIter = 80000) {\n  const start = { pos: [1.2, 0.36, 0.28], quat: [1, 0, 0, 0], parent: -1 };\n  // Multiple well-separated goal seeds inside workspace [-0.5..2.8]^3\n  const goalSeeds = [\n    { pos: [2.4, 2.4, 1.4], quat: [1, 0, 0, 0], parent: -1 },\n    { pos: [-0.2, 2.3, 1.3], quat: [1, 0, 0, 0], parent: -1 },\n    { pos: [1.2, -0.4, 1.5], quat: [1, 0, 0, 0], parent: -1 },\n    { pos: [2.5, -0.3, 1.2], quat: [1, 0, 0, 0], parent: -1 },\n  ].filter(g => minClearance(g.pos, g.quat, 0.45) >= 0.45);\n  console.log('Valid goal seeds (>0.45m separation):', goalSeeds.length, goalSeeds.map(g => minClearance(g.pos, g.quat, 0).toFixed(3)));\n\n  let treeA = [start];\n  let treeB = goalSeeds.slice();\n  let swapped = false;\n\n  function nearest(tree, q) {\n    let best = 0, bestD = 1e9;\n    for (let i = 0; i < tree.length; i++) {\n      const d = cfgDist(tree[i], q);\n      if (d < bestD) { bestD = d; best = i; }\n    }\n    return best;\n  }\n\n  function stepToward(from, to, maxStep = 0.08) {\n    const d = cfgDist(from, to);\n    const t = d <= maxStep ? 1.0 : maxStep / d;\n    return {\n      pos: [from.pos[0]+t*(to.pos[0]-from.pos[0]), from.pos[1]+t*(to.pos[1]-from.pos[1]), from.pos[2]+t*(to.pos[2]-from.pos[2])],\n      quat: slerp(from.quat, to.quat, t)\n    };\n  }\n\n  function extend(tree, target, useSlide = true) {\n    let curIdx = nearest(tree, target);\n    let steps = 0;\n    while (steps < 25) {\n      const cur = tree[curIdx];\n      let cand = stepToward(cur, target, 0.07);\n      let c = minClearance(cand.pos, cand.quat, margin);\n      if (c < margin && useSlide) {\n        // Try sliding along 6-DOF clearance gradient!\n        const slid = repel6DOF(cand.pos, cand.quat, margin + 0.008, 4);\n        if (cfgDist(cur, slid) > 0.01 && cfgDist(cur, slid) < 0.14 && minClearance(slid.pos, slid.quat, margin) >= margin) {\n          cand = slid;\n          c = margin;\n        } else {\n          break;\n        }\n      }\n      if (c < margin || !edgeValid(cur, cand, margin)) break;\n      cand.parent = curIdx;\n      tree.push(cand);\n      curIdx = tree.length - 1;\n      if (cfgDist(cand, target) < 1e-4) return { status: 'reached', idx: curIdx };\n      // If treeA itself already reached separation > 0.43m, we can stop immediately!\n      if (!swapped && minClearance(cand.pos, cand.quat, 0) >= 0.43) {\n        return { status: 'goal_direct', idx: curIdx };\n      }\n      steps++;\n    }\n    return steps > 0 ? { status: 'advanced', idx: curIdx } : { status: 'trapped', idx: curIdx };\n  }\n\n  for (let it = 0; it < maxIter; it++) {\n    // Biased sampling: 65% around interlocking region [-0.2..2.6, -0.3..1.9, -0.5..1.2], 35% wider\n    let pos;\n    if (Math.random() < 0.70) {\n      pos = [-0.2 + Math.random()*2.8, -0.3 + Math.random()*2.2, -0.5 + Math.random()*1.7];\n    } else {\n      pos = [-0.5 + Math.random()*3.3, -0.5 + Math.random()*3.3, -0.5 + Math.random()*2.8];\n    }\n    const u1 = Math.random(), u2 = Math.random()*6.283185, u3 = Math.random()*6.283185;\n    const s1 = Math.sqrt(1-u1), s2 = Math.sqrt(u1);\n    let qRand = { pos, quat: [s1*Math.sin(u2), s1*Math.cos(u2), s2*Math.sin(u3), s2*Math.cos(u3)] };\n\n    // Occasionally push colliding samples onto C-space medial surface (OBPRM-style narrow passage sample!)\n    if (minClearance(qRand.pos, qRand.quat, margin) < margin) {\n      if (Math.random() < 0.5) {\n        qRand = repel6DOF(qRand.pos, qRand.quat, margin + 0.010, 6);\n        if (minClearance(qRand.pos, qRand.quat, margin) < margin) continue;\n      } else continue;\n    }\n\n    const resA = extend(treeA, qRand, true);\n    if (resA.status === 'goal_direct') {\n      console.log(`SOLVED directly at iter ${it}! treeA=${treeA.length}`);\n      const path = [];\n      for (let k = resA.idx; k !== -1; k = treeA[k].parent) path.push(treeA[k]);\n      return path.reverse();\n    }\n    if (resA.status !== 'trapped') {\n      const qNew = treeA[resA.idx];\n      const resB = extend(treeB, qNew, true);\n      if (resB.status === 'reached') {\n        console.log(`SOLVED via RRT-Connect at iter ${it}! treeA=${treeA.length}, treeB=${treeB.length}`);\n        let pA = [], pB = [];\n        for (let k = resA.idx; k !== -1; k = treeA[k].parent) pA.push(treeA[k]);\n        for (let k = resB.idx; k !== -1; k = treeB[k].parent) pB.push(treeB[k]);\n        pA.reverse();\n        pB.shift(); // avoid duplicate meeting node\n        const full = swapped ? pB.reverse().concat(pA.reverse()) : pA.concat(pB);\n        //Wait: let's assemble carefully if swapped!\n        if (swapped) {\n          let sPath = [], gPath = [];\n          for (let k = resB.idx; k !== -1; k = treeB[k].parent) sPath.push(treeB[k]);\n          for (let k = resA.idx; k !== -1; k = treeA[k].parent) gPath.push(treeA[k]);\n          sPath.reverse();\n          gPath.shift();\n          return sPath.concat(gPath);\n        } else {\n          return pA.concat(pB);\n        }\n      }\n    }\n    if (treeA.length > treeB.length) {\n      const tmp = treeA; treeA = treeB; treeB = tmp;\n      swapped = !swapped;\n    }\n    if ((it + 1) % 5000 === 0) {\n      console.log(`iter ${it+1}: treeA=${treeA.length}, treeB=${treeB.length} (swapped=${swapped})`);\n    }\n  }\n  return null;\n}\n\nconsole.time('rrt');\nconst path = solveRRT(0.010, 80000);\nconsole.timeEnd('rrt');\nif (path) {\n  console.log('Raw path waypoints:', path.length);\n  let minC = 1e9;\n  for (const w of path) {\n    const c = minClearance(w.pos, w.quat, 0);\n    if (c < minC) minC = c;\n  }\n  console.log('Raw path min waypoint clearance:', minC.toFixed(5), 'end clearance:', minClearance(path[path.length-1].pos, path[path.length-1].quat, 0).toFixed(5));\n  fs.writeFileSync('/tmp/opencode/raw_path.json', JSON.stringify(path.map(p => ({ pos: p.pos, quat: p.quat }))));\n}\nEOF" action.permission=* action.action=allow action.pattern=*
