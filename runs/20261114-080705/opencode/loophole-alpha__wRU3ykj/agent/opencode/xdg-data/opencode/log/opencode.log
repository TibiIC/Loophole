timestamp=2026-11-14T06:19:45.829Z level=INFO run=03a05625 message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/opencode/inspect_scene.py\nimport zlib, struct, math\n\ndef read_png(path):\n    data = open(path, \"rb\").read()\n    pos = 8\n    idat = bytearray()\n    while pos < len(data):\n        length, ctype = struct.unpack(\">I4s\", data[pos:pos+8])\n        chunk = data[pos+8:pos+8+length]\n        pos += 12 + length\n        if ctype == b\"IHDR\":\n            w, h, bd, ct, comp, filt, inter = struct.unpack(\">IIBBBBB\", chunk)\n        elif ctype == b\"IDAT\":\n            idat.extend(chunk)\n    raw = zlib.decompress(bytes(idat))\n    bpp = {2: 3, 6: 4}[ct]\n    stride = w * bpp\n    rows = []\n    prev = bytearray(stride)\n    i = 0\n    for y in range(h):\n        f = raw[i]\n        row = bytearray(raw[i+1:i+1+stride])\n        i += 1 + stride\n        if f == 1:\n            for x in range(bpp, stride): row[x] = (row[x] + row[x-bpp]) & 0xff\n        elif f == 2:\n            for x in range(stride): row[x] = (row[x] + prev[x]) & 0xff\n        elif f == 3:\n            for x in range(stride):\n                a = row[x-bpp] if x >= bpp else 0\n                row[x] = (row[x] + ((a + prev[x]) >> 1)) & 0xff\n        elif f == 4:\n            for x in range(stride):\n                a = row[x-bpp] if x >= bpp else 0\n                b = prev[x]\n                c = prev[x-bpp] if x >= bpp else 0\n                p = a + b - c\n                pa, pb, pc = abs(p-a), abs(p-b), abs(p-c)\n                pr = a if (pa <= pb and pa <= pc) else (b if pb <= pc else c)\n                row[x] = (row[x] + pr) & 0xff\n        rows.append(bytes(row))\n        prev = row\n    return w, h, bpp, rows\n\nfor name in [\"top\", \"front\", \"side\", \"back\", \"iso\"]:\n    w, h, bpp, rows = read_png(f\"/tmp/opencode/{name}.png\")\n    red_pts, blue_pts, grey_pts = [], [], []\n    bg = (rows[0][0], rows[0][1], rows[0][2])\n    for y in range(h):\n        r_row = rows[y]\n        for x in range(w):\n            idx = x * bpp\n            r, g, b = r_row[idx], r_row[idx+1], r_row[idx+2]\n            if (r, g, b) == bg:\n                continue\n            if r > g + 40 and r > b + 40:\n                red_pts.append((x, y, r, g, b))\n            elif b > r + 30 and b > g + 15:\n                blue_pts.append((x, y, r, g, b))\n            elif abs(r - bg[0]) > 15 or abs(g - bg[1]) > 15 or abs(b - bg[2]) > 15:\n                grey_pts.append((x, y, r, g, b))\n    def centroid(pts):\n        if not pts: return None\n        return (sum(p[0] for p in pts)/len(pts), sum(p[1] for p in pts)/len(pts))\n    print(f\"{name}: {w}x{h} bpp={bpp} bg={bg} red={len(red_pts)} {centroid(red_pts)} blue={len(blue_pts)} {centroid(blue_pts)} grey={len(grey_pts)} {centroid(grey_pts)}\")\nEOF" action.permission=* action.action=allow action.pattern=*
