timestamp=2026-11-14T06:43:03.289Z level=INFO run=03a05625 message=evaluated permission=bash pattern="cat << 'EOF' > /tmp/opencode/measure_throat_solid.js\nconst fs = require('fs');\nconst { R_A, t_A, pts5mm } = JSON.parse(fs.readFileSync('/tmp/opencode/pts5mm.json', 'utf8'));\n\n// Note: cleanLocal had coords like 1.0 + k*0.01 + 0.005, then +/- 0.0025 -> 0.0025 + m*0.005 or similar!\n// Let's check exact coordinate spacing first:\nlet minP = [1e9,1e9,1e9];\nfor (const p of pts5mm) for (let d=0;d<3;d++) if (p[d] < minP[d]) minP[d] = p[d];\nconst idxPts = pts5mm.map(p => [\n  Math.round((p[0] - minP[0]) / 0.005),\n  Math.round((p[1] - minP[1]) / 0.005),\n  Math.round((p[2] - minP[2]) / 0.005)\n]);\nlet maxI = [0,0,0];\nfor (const q of idxPts) for (let d=0;d<3;d++) if (q[d] > maxI[d]) maxI[d] = q[d];\nconst NX = maxI[0] + 5, NY = maxI[1] + 5, NZ = maxI[2] + 5;\nconst NXYZ = NX * NY * NZ;\nconsole.log(`5mm grid: ${NX}x${NY}x${NZ} (${(NXYZ/1e6).toFixed(2)}M cells)`);\n\n// state: 0 = unknown, 1 = shell, 2 = exterior (BFS from [0,0,0])\nconst state = new Uint8Array(NXYZ);\nfor (const q of idxPts) {\n  state[((q[2]+2)*NY + (q[1]+2))*NX + (q[0]+2)] = 1;\n}\n\n// Flood-fill exterior (6-connected) from 0\nconst queue = new Int32Array(NXYZ);\nlet head = 0, tail = 0;\nstate[0] = 2;\nqueue[tail++] = 0;\nconst strideZ = NY * NX;\nwhile (head < tail) {\n  const cur = queue[head++];\n  const iz = (cur / strideZ) | 0;\n  const rem = cur - iz * strideZ;\n  const iy = (rem / NX) | 0;\n  const ix = rem - iy * NX;\n  if (ix > 0 && state[cur - 1] === 0) { state[cur - 1] = 2; queue[tail++] = cur - 1; }\n  if (ix + 1 < NX && state[cur + 1] === 0) { state[cur + 1] = 2; queue[tail++] = cur + 1; }\n  if (iy > 0 && state[cur - NX] === 0) { state[cur - NX] = 2; queue[tail++] = cur - NX; }\n  if (iy + 1 < NY && state[cur + NX] === 0) { state[cur + NX] = 2; queue[tail++] = cur + NX; }\n  if (iz > 0 && state[cur - strideZ] === 0) { state[cur - strideZ] = 2; queue[tail++] = cur - strideZ; }\n  if (iz + 1 < NZ && state[cur + strideZ] === 0) { state[cur + strideZ] = 2; queue[tail++] = cur + strideZ; }\n}\n\nlet solidCount = 0;\nconst outerSurf = [];\nconst INF = 1e6;\nconst edtIn = new Float32Array(NXYZ);\nfor (let iz = 0; iz < NZ; iz++)\n  for (let iy = 0; iy < NY; iy++)\n    for (let ix = 0; ix < NX; ix++) {\n      const idx = iz * strideZ + iy * NX + ix;\n      if (state[idx] !== 2) {\n        solidCount++;\n        edtIn[idx] = INF;\n        if (state[idx - 1] === 2 || state[idx + 1] === 2 ||\n            state[idx - NX] === 2 || state[idx + NX] === 2 ||\n            state[idx - strideZ] === 2 || state[idx + strideZ] === 2) {\n          outerSurf.push([\n            minP[0] + (ix - 2) * 0.005,\n            minP[1] + (iy - 2) * 0.005,\n            minP[2] + (iz - 2) * 0.005\n          ]);\n        }\n      }\n    }\nconsole.log(`Solid 5mm voxels: ${solidCount} (was ${pts5mm.length} shell), TRUE outer surface pts: ${outerSurf.length}`);\n\n// 3D interior EDT\n{\n  const maxN = Math.max(NX, NY, NZ);\n  const f = new Float32Array(maxN), d = new Float32Array(maxN), v = new Int32Array(maxN), z = new Float32Array(maxN + 1);\n  function edt1d(n) {\n    let k = 0; v[0] = 0; z[0] = -INF; z[1] = INF;\n    for (let q = 1; q < n; q++) {\n      let s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]);\n      while (s <= z[k]) { k--; s = ((f[q] + q * q) - (f[v[k]] + v[k] * v[k])) / (2 * q - 2 * v[k]); }\n      k++; v[k] = q; z[k] = s; z[k + 1] = INF;\n    }\n    k = 0;\n    for (let q = 0; q < n; q++) {\n      while (z[k + 1] < q) k++;\n      const dx = q - v[k];\n      d[q] = dx * dx + f[v[k]];\n    }\n  }\n  for (let iz = 0; iz < NZ; iz++)\n    for (let iy = 0; iy < NY; iy++) {\n      const base = iz * strideZ + iy * NX;\n      for (let ix = 0; ix < NX; ix++) f[ix] = edtIn[base + ix];\n      edt1d(NX);\n      for (let ix = 0; ix < NX; ix++) edtIn[base + ix] = d[ix];\n    }\n  for (let iz = 0; iz < NZ; iz++)\n    for (let ix = 0; ix < NX; ix++) {\n      for (let iy = 0; iy < NY; iy++) f[iy] = edtIn[iz * strideZ + iy * NX + ix];\n      edt1d(NY);\n      for (let iy = 0; iy < NY; iy++) edtIn[iz * strideZ + iy * NX + ix] = d[iy];\n    }\n  for (let iy = 0; iy < NY; iy++)\n    for (let ix = 0; ix < NX; ix++) {\n      for (let iz = 0; iz < NZ; iz++) f[iz] = edtIn[iz * strideZ + iy * NX + ix];\n      edt1d(NZ);\n      for (let iz = 0; iz < NZ; iz++) edtIn[iz * strideZ + iy * NX + ix] = Math.sqrt(d[iz]) * 0.005;\n    }\n}\n\nlet maxRad = 0;\nconst medial = [];\nfor (let iz = 2; iz < NZ - 2; iz++)\n  for (let iy = 2; iy < NY - 2; iy++)\n    for (let ix = 2; ix < NX - 2; ix++) {\n      const val = edtIn[iz * strideZ + iy * NX + ix];\n      if (val > maxRad) maxRad = val;\n      if (val <= 0.025) continue;\n      let higher = 0;\n      for (let dz=-1;dz<=1;dz++)\n        for (let dy=-1;dy<=1;dy++)\n          for (let dx=-1;dx<=1;dx++) {\n            if (!dx && !dy && !dz) continue;\n            if (edtIn[(iz+dz)*strideZ + (iy+dy)*NX + (ix+dx)] > val + 1e-6) higher++;\n          }\n      if (higher <= 3) {\n        medial.push({\n          x: minP[0] + (ix - 2) * 0.005,\n          y: minP[1] + (iy - 2) * 0.005,\n          z: minP[2] + (iz - 2) * 0.005,\n          r: val\n        });\n      }\n    }\n\nconsole.log(`Max inscribed tube radius: ${maxRad.toFixed(5)}m (diameter ${(2*maxRad).toFixed(5)}m), medial pts: ${medial.length}`);\n\nmedial.sort((a, b) => b.r - a.r);\nconst nodes = [];\nfor (const m of medial) {\n  let close = false;\n  for (const n of nodes) if (Math.hypot(m.x-n.x, m.y-n.y, m.z-n.z) < 0.025) { close = true; break; }\n  if (!close) nodes.push(m);\n}\nlet startIdx = 0, bestX = -1e9;\nfor (let i = 0; i < nodes.length; i++) if (nodes[i].x > bestX) { bestX = nodes[i].x; startIdx = i; }\nconst ordered = [nodes[startIdx]];\nconst used = new Uint8Array(nodes.length);\nused[startIdx] = 1;\nwhile (ordered.length < nodes.length) {\n  const cur = ordered[ordered.length - 1];\n  let best = -1, bestD = 1e9;\n  for (let i = 0; i < nodes.length; i++) {\n    if (used[i]) continue;\n    const d = Math.hypot(cur.x-nodes[i].x, cur.y-nodes[i].y, cur.z-nodes[i].z);\n    if (d < bestD) { bestD = d; best = i; }\n  }\n  if (best === -1 || bestD > 0.12) break;\n  used[best] = 1;\n  ordered.push(nodes[best]);\n}\nconsole.log(`Ordered curve nodes: ${ordered.length}/${nodes.length}`);\nconst radii = ordered.map(n => n.r).sort((a,b) => a-b);\nconst medR = radii[Math.floor(radii.length*0.5)];\nconsole.log(`Radius along curve: p10=${radii[Math.floor(radii.length*0.1)].toFixed(4)} median=${medR.toFixed(4)} p90=${radii[Math.floor(radii.length*0.9)].toFixed(4)}`);\n\nlet minThroat = 1e9, throatPair = null;\nfor (let i = 0; i < ordered.length; i++) {\n  for (let j = i + 25; j < ordered.length; j++) {\n    const d = Math.hypot(ordered[i].x-ordered[j].x, ordered[i].y-ordered[j].y, ordered[i].z-ordered[j].z);\n    if (d < minThroat) { minThroat = d; throatPair = [i, j, ordered[i], ordered[j]]; }\n  }\n}\nconst [ti, tj, p1, p2] = throatPair;\nconsole.log(`THROAT center-to-center = ${minThroat.toFixed(5)}m between idx ${ti} (${p1.x.toFixed(3)},${p1.y.toFixed(3)},${p1.z.toFixed(3)} r=${p1.r.toFixed(4)}) and idx ${tj} (${p2.x.toFixed(3)},${p2.y.toFixed(3)},${p2.z.toFixed(3)} r=${p2.r.toFixed(4)})`);\nconsole.log(`THROAT surface gap = ${(minThroat - p1.r - p2.r).toFixed(5)}m vs tube diameter = ${(2*medR).toFixed(5)}m`);\nconsole.log(`=> EXCESS CLEARANCE = ${(minThroat - p1.r - p2.r - 2*medR).toFixed(5)}m!!`);\n\nfs.writeFileSync('/tmp/opencode/solid_alpha.json', JSON.stringify({ R_A, t_A, ordered, outerSurf }));\nEOF" action.permission=* action.action=allow action.pattern=*
