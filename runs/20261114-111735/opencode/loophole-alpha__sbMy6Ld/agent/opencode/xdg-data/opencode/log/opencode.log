timestamp=2026-11-14T09:32:11.629Z level=INFO run=881cf0d6 message=evaluated permission=bash pattern="python3 -c '\nimport numpy as np\nfrom scipy.spatial import cKDTree\n\npts_a = np.load(\"/app/pts_a.npy\")\ntree_a = cKDTree(pts_a)\n\n# Test R around 0.100..0.120\nrng = np.random.default_rng(42)\nsp = pts_a[rng.choice(len(pts_a), 20000, replace=False)]\n_, nn = tree_a.query(sp, k=40)\nnb = pts_a[nn]\nc = nb - nb.mean(axis=1, keepdims=True)\nev, evec = np.linalg.eigh(np.einsum(\"nki,nkj->nij\", c, c))\nsn = evec[:, :, 0]\n\nfor r_test in np.linspace(0.102, 0.112, 21):\n    d = np.minimum(tree_a.query(sp + 2*r_test*sn)[0], tree_a.query(sp - 2*r_test*sn)[0])\n    print(f\"R={r_test:.5f} (2R={2*r_test:.5f}): med={np.median(d):.6f}, p25={np.percentile(d,25):.6f}, p10={np.percentile(d,10):.6f}\")\n\n# Also slice the straight leg near X in [1.5, 2.1]\nslice_x = pts_a[(pts_a[:, 0] > 1.6) & (pts_a[:, 0] < 2.0)]\nprint(\"Slice X in [1.6, 2.0] count:\", len(slice_x))\nif len(slice_x) > 0:\n    yz = slice_x[:, 1:3]\n    # Fit a circle in YZ!\n    # y^2 + z^2 = 2*cy*y + 2*cz*z + (R^2 - cy^2 - cz^2)\n    A = np.column_stack([2*yz[:,0], 2*yz[:,1], np.ones(len(yz))])\n    b = (yz**2).sum(axis=1)\n    sol, _, _, _ = np.linalg.lstsq(A, b, rcond=None)\n    cy, cz = sol[0], sol[1]\n    R_fit = np.sqrt(sol[2] + cy**2 + cz**2)\n    rad = np.linalg.norm(yz - np.array([cy, cz]), axis=1)\n    print(f\"Slice X=[1.6,2.0] YZ circle fit: cy={cy:.6f}, cz={cz:.6f}, R={R_fit:.6f}, std(r)={rad.std():.6f}, min(r)={rad.min():.6f}, max(r)={rad.max():.6f}\")\n'" action.permission=* action.action=allow action.pattern=*
